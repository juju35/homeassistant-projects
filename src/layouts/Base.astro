---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "@fontsource/cookie/400.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { OWNER } from "../lib/projects";
const LINKEDIN = "https://www.linkedin.com/in/julien-stephan-70a5522b/";
const COFFEE = "https://buymeacoffee.com/julienstep9";

interface Props {
  title: string;
  description: string;
  /** Path, under the site's base, of the 1200×630 picture shown when the page is shared (default: og.png). */
  image?: string;
}
const { title, description, image: imagePath = "og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL;
const pageTitle = title === "Home Assistant projects" ? title : `${title} · Home Assistant projects`;
const image = new URL(`${base}${imagePath}`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Home Assistant projects" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}: ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="HA projects" />
    <meta name="theme-color" content="#e9ecef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111315" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap.xml`} type="application/xml" />
    <script is:inline>
      // Before first paint, so the page never flashes the wrong theme.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t;
          // The browser bar follows the chosen theme, not only the system one
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = t === "dark" ? "#111315" : "#e9ecef";
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="wrap bar">
        <a class="brand" href={base}>
          <span class="logo sm" style="--c:#41bdf5"><Icon name="mdiHomeAssistant" /></span>
          <span class="brand-text"><b>Home Assistant</b> projects</span>
        </a>
        <nav class="actions">
          <a class="coffee-btn" href={COFFEE} target="_blank" rel="noopener" title="Buy me a coffee">
            <svg class="coffee-cup" aria-hidden="true" viewBox="0 0 24 24"><g fill="none" stroke="#0D0C22" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M6.9 10.2 8.2 21.1c.1.6.5.9 1 .9h5.6c.5 0 .9-.3 1-.9l1.3-10.9" fill="#fff"/><path d="M7.4 12.6c1.6-.7 3.3.5 4.9-.1 1.4-.6 2.7-.6 4.1-.2L16.7 10.2H7.3Z" fill="#FFDD00" stroke="none"/><rect x="5.3" y="7.4" width="13.4" height="2.9" rx="1.45" fill="#FFDD00"/><path d="M8.4 7.3V5.6c0-.9 1.6-1.9 3.6-1.9s3.6 1 3.6 1.9v1.7" fill="#FFDD00"/></g></svg><span>Buy me a coffee</span>
          </a>
          <a class="icon-btn" href={`https://github.com/${OWNER}`} title="GitHub" aria-label="GitHub profile"><Icon name="mdiGithub" /></a>
          <a class="icon-btn" href={LINKEDIN} title="LinkedIn" aria-label="LinkedIn profile" rel="me noopener"><Icon name="mdiLinkedin" /></a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Theme: system" title="Theme: system" data-mode="auto">
            <Icon name="mdiThemeLightDark" class="ic-auto" />
            <Icon name="mdiWhiteBalanceSunny" class="ic-light" />
            <Icon name="mdiWeatherNight" class="ic-dark" />
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1"><slot /></main>

    <button class="to-top icon-btn" id="to-top" type="button" aria-label="Back to top" title="Back to top" hidden>
      <Icon name="mdiArrowUp" />
    </button>

    <footer class="wrap footer muted">
      <span>Made by <a href={`https://github.com/${OWNER}`}>{OWNER}</a> (<a href={LINKEDIN} rel="me noopener">LinkedIn</a>) · Every project is free and open source · <a href={`${base}#contributing`}>Contributions</a></span>
      <span>Not affiliated with Home Assistant or the brands shown</span>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const toggle = document.getElementById("theme-toggle");
        // Three states: system (follows prefers-color-scheme), light, dark.
        const MODES = ["auto", "light", "dark"];
        const LABEL = { auto: "system", light: "light", dark: "dark" };
        const read = () => {
          const t = localStorage.getItem("theme");
          return t === "light" || t === "dark" ? t : "auto";
        };
        const setMetas = (mode) => {
          for (const m of metas) {
            const isDark = (m.getAttribute("media") || "").includes("dark");
            m.content = mode === "dark" || (mode === "auto" && isDark) ? "#111315" : "#e9ecef";
          }
        };
        const apply = (mode) => {
          if (mode === "auto") {
            delete root.dataset.theme;
            try { localStorage.removeItem("theme"); } catch {}
          } else {
            root.dataset.theme = mode;
            try { localStorage.setItem("theme", mode); } catch {}
          }
          setMetas(mode);
          toggle.dataset.mode = mode;
          const label = "Theme: " + LABEL[mode];
          toggle.setAttribute("aria-label", label);
          toggle.title = label;
        };
        apply(read());
        toggle.addEventListener("click", () => apply(MODES[(MODES.indexOf(read()) + 1) % MODES.length]));
        // Back to top, once the page has been scrolled for two screens
        const up = document.getElementById("to-top");
        up.hidden = false;
        const show = () => up.classList.toggle("show", scrollY > innerHeight * 2);
        addEventListener("scroll", show, { passive: true });
        show();
        up.addEventListener("click", () => {
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
          document.getElementById("main").focus({ preventScroll: true });
        });
      })();
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--primary-background-color) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);

    border-bottom: 1px solid var(--divider-color);
  }
  .bar { display: flex; align-items: center; gap: 12px; height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 16px; }
  .brand b { font-weight: 500; }
  .brand-text { color: var(--secondary-text-color); }
  .brand-text b { color: var(--primary-text-color); }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 4px; }
  /* Buy Me a Coffee, on every page: the official button (yellow pill, the take-away cup, Cookie lettering in BMC navy) */
  .coffee-btn {
    display: inline-flex; align-items: center; gap: 5px; flex: none; height: 36px; padding: 0 16px 0 10px; margin-right: 6px;
    border-radius: 18px; background: #ffdd00; color: #0d0c22; white-space: nowrap;
    font: 400 23px/1 "Cookie", cursive; -webkit-text-stroke: 0.35px #0d0c22;
    transition: filter 0.2s ease;
  }
  .coffee-cup { width: 26px; height: 26px; flex: none; }
  .coffee-btn:hover { filter: brightness(1.04); }
  .coffee-btn:focus-visible { outline: 2px solid var(--focus-color); outline-offset: 2px; }
  /* Narrowest phones: a smaller button so the theme switch still fits */
  @media (max-width: 360px) {
    .actions { gap: 0; }
    .coffee-btn { height: 32px; padding: 0 12px 0 7px; margin-right: 4px; font-size: 20px; }
    .coffee-cup { width: 22px; height: 22px; }
  }
  #theme-toggle .ic-auto, #theme-toggle .ic-light, #theme-toggle .ic-dark { display: none; }
  #theme-toggle[data-mode="auto"] .ic-auto { display: block; }
  #theme-toggle[data-mode="light"] .ic-light { display: block; }
  #theme-toggle[data-mode="dark"] .ic-dark { display: block; }
  main { min-height: calc(100vh - 160px); outline: none; }
  .footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
    padding-top: 32px; padding-bottom: 40px; font-size: 13px;
  }
  .footer a { color: var(--primary-text-color); font-weight: 500; }
  @media (max-width: 480px) { .brand-text { display: none; } }
  .to-top {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 9;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--card-background-color); color: var(--primary-text-color);
    border: 1px solid var(--divider-color); box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity .2s ease, transform .2s ease, visibility .2s;
  }
  .to-top.show { opacity: 1; visibility: visible; transform: none; }
  @media (prefers-reduced-motion: reduce) { .to-top { transition: none; } }
</style>
