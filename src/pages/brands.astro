---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectLogo from "../components/ProjectLogo.astro";
import { brands } from "../lib/brands";

const list = await brands();
const base = import.meta.env.BASE_URL;
const letter = (name: string) => {
  const c = name.normalize("NFD")[0].toUpperCase();
  return /[A-Z]/.test(c) ? c : "#";
};
const letters = [...new Set(list.map((b) => letter(b.name)))];
const fold = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
---

<Base title="Brands" description={`The ${list.length} brands and integrations the Home Assistant projects work with, and which project supports each.`}>
  <section class="wrap head">
    <h1 class="section-title"><Icon name="mdiTagMultipleOutline" />Brands &amp; integrations</h1>
    <p class="muted lead">{list.length} brands and integrations, and the cards and integrations that support them.</p>
    <div class="tools">
      <label class="search tile">
        <Icon name="mdiMagnify" />
        <input type="search" id="bq" placeholder="Search a brand" autocomplete="off" aria-label="Search a brand" />
      </label>
      <nav class="letters" aria-label="Initials">
        {letters.map((l) => <a class="chip neutral" href={`#letter-${l === "#" ? "0" : l}`}>{l}</a>)}
      </nav>
    </div>
  </section>

  <div class="wrap">
    {letters.map((l) => (
      <section class="letter-group" id={`letter-${l === "#" ? "0" : l}`} data-letter>
        <h2 class="letter">{l}</h2>
        <ul class="brand-grid">
          {list.filter((b) => letter(b.name) === l).map((b) => (
            <li class="ha-card brand-card" id={b.id} data-name={fold(b.name)}>
              <div class="brand-head">
                <img src={b.src} alt="" loading="lazy" decoding="async" />
                <div>
                  <h3 class="brand-title">{b.name}</h3>
                  <span class="muted n">{b.projects.length} project{b.projects.length > 1 ? "s" : ""}</span>
                </div>
              </div>
              <ul class="uses">
                {b.projects.map((p) => (
                  <li style={`--c:${p.accent}`}>
                    <a href={`${base}projects/${p.slug}/`}><ProjectLogo project={p} size="sm" />{p.title}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="muted empty" id="bempty" hidden>No brand matches this search.</p>
  </div>
</Base>

<script>
  {
    const q = document.getElementById("bq") as HTMLInputElement;
    const cards = [...document.querySelectorAll<HTMLElement>(".brand-card")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-letter]")];
    const fold = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
    q.addEventListener("input", () => {
      const t = fold(q.value);
      for (const c of cards) c.hidden = !!t && !c.dataset.name!.includes(t);
      for (const g of groups) g.hidden = !g.querySelector(".brand-card:not([hidden])");
      document.getElementById("bempty")!.hidden = cards.some((c) => !c.hidden);
    });
    addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement !== q) { e.preventDefault(); q.focus(); }
    });
    // Coming from a project page: the brand is highlighted
    const hit = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (hit?.classList.contains("brand-card")) hit.classList.add("hit");
  }
</script>

<style>
  .head { padding-top: 24px; }
  h1.section-title { font-size: 22px; margin: 0; }
  h1.section-title :global(svg) { width: 22px; height: 22px; }
  .lead { margin: 6px 0 0; font-size: 15px; }
  .tools {
    position: sticky; top: 61px; z-index: 5; display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    margin-top: 16px; padding: 10px 0;
    background: color-mix(in srgb, var(--primary-background-color) 92%, transparent); backdrop-filter: blur(14px);
  }
  .search {
    flex: 0 1 320px; display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-radius: 20px;
    background: var(--card-background-color); border: 1px solid var(--divider-color); color: var(--secondary-text-color);
  }
  .search :global(svg) { width: 20px; height: 20px; flex: none; }
  .search input { all: unset; flex: 1; min-width: 0; font-size: 14px; color: var(--primary-text-color); }
  .search:focus-within { border-color: var(--focus-color); outline: 2px solid var(--focus-color); outline-offset: 1px; }
  .letters { display: flex; gap: 4px; flex-wrap: wrap; }
  .letters .chip { min-width: 28px; justify-content: center; padding: 3px 6px; }
  .letter-group { scroll-margin-top: 130px; }
  .letter { margin: 24px 0 10px; font-size: 18px; font-weight: 500; color: var(--secondary-text-color); }
  .brand-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .brand-card { padding: 14px; scroll-margin-top: 130px; transition: box-shadow .3s ease; }
  .brand-card.hit { box-shadow: 0 0 0 2px var(--primary-color); }
  .brand-head { display: flex; align-items: center; gap: 12px; }
  /* On a white chip, so dark logos stay readable in the dark theme */
  .brand-head img {
    height: 44px; width: 64px; object-fit: contain; padding: 5px; box-sizing: border-box; flex: none;
    background: #fff; border-radius: 10px;
  }
  .brand-title { margin: 0; font-size: 16px; font-weight: 500; }
  .n { font-size: 12px; }
  .uses { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .uses a {
    display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 3px; border-radius: 16px; font-size: 13px;
    color: var(--primary-text-color); background: var(--secondary-background-color); transition: background-color .2s ease;
  }
  .uses a:hover { background: color-mix(in srgb, var(--c) 14%, var(--secondary-background-color)); }
  .uses :global(.logo.sm) { width: 24px; height: 24px; }
  .uses :global(.logo.sm svg) { width: 14px; height: 14px; }
  .empty { padding: 40px 0; text-align: center; }
  @media (max-width: 600px) {
    .tools { position: static; }
    .search { flex: 1 1 100%; }
  }
</style>
