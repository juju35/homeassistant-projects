---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ProjectLogo from "../../components/ProjectLogo.astro";
import Shot from "../../components/Shot.astro";
import Docs from "../../components/Docs.astro";
import Gallery from "../../components/Gallery.astro";
import Networks from "../../components/Networks.astro";
import MarketplaceBadge from "../../components/MarketplaceBadge.astro";
import {
  projects,
  repoUrl,
  marketplaceUrl,
  kindLabel,
  caption,
  categoryOf,
  shotUrl,
  shotCount as countShots,
  hasGallery as showsGallery,
  type Project,
} from "../../lib/projects";
import { latestRelease, formatDate } from "../../lib/releases";
import { imageSize } from "../../lib/imgsize";
import { getChangelog } from "../../lib/changelog";
import { getLogos } from "../../lib/logos";
import { readme } from "../../lib/readme";
import { networks } from "../../lib/networks";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const accent = `--c:${project.accent}`;
const category = categoryOf(project);
const isCard = project.kind === "card";
const cardTypes = project.cardTypes ?? [];
const yaml = cardTypes.length ? `type: custom:${cardTypes[0]}` : "";
const shotCount = countShots(project);
// The gallery is left out when its only capture is the hero
const hasGallery = showsGallery(project);
const release = await latestRelease(project);
// Captures are taken at 2x: the hero is shown at most at its own size (half its pixels), never enlarged.
const heroSize = project.hero ? await imageSize(shotUrl(project, project.hero.src)) : null;
const heroStyle = heroSize ? `--shot-w:${Math.round(heroSize.w / 2)}px` : undefined;
const changelog = await getChangelog(project);
// Brands and integrations the project supports: the logos at the top of its README
const { brands } = await getLogos(project);
// Long lists (a card for every car brand) show the first ones, the rest behind "Show all"
const BRANDS_SHOWN = 12;
// Cities and networks of a public transport project, listed in its README
const md = await readme(project);
const hasNetworks = !!(md && networks(md));
// Projects this one works with, declared on either side
const related = projects.flatMap((p) => {
  if (p.slug === project.slug) return [];
  const mine = project.worksWith?.find((w) => w.slug === p.slug);
  const theirs = p.worksWith?.find((w) => w.slug === project.slug);
  return mine || theirs ? [{ p, why: mine?.why ?? `${p.title} works with ${project.title}` }] : [];
});
// The project that replaces an archived one.
const replacement = project.replacedBy ? projects.find((p) => p.slug === project.replacedBy) : undefined;
---

<Base title={project.title} description={project.tagline} image={`og/${project.slug}.png`}>
  <div class="wrap page" style={accent}>
    <a class="back muted" href={base}><Icon name="mdiChevronLeft" /> All projects</a>

    <!-- Header -->
    <section class="ha-card intro" id="overview">
      <div class="header top">
        <ProjectLogo project={project} size="lg" accent own />
        <div class="titles">
          <h1>{project.title}</h1>
          <div class="sub">{kindLabel(project)} · {category.label}</div>
        </div>
        <div class="chips">
          {release && (
            <a class="chip neutral rel" href={release.url} target="_blank" rel="noopener" title="Latest release and its changelog">
              <Icon name="mdiTagOutline" /> {release.tag} · {formatDate(release.date)}
            </a>
          )}
          <span class="chip neutral"><Icon name="mdiHomeAssistant" /> HA {project.homeassistant}+</span>
          {project.archived ? (
            <span class="chip archived-chip"><Icon name="mdiArchiveOutline" /> Archived</span>
          ) : (
            <span class="chip" style={accent}><Icon name="mdiStorefrontOutline" /> Marketplace</span>
          )}
        </div>
      </div>
      {project.archived && (
        <div class="archived-banner" role="note">
          <Icon name="mdiArchiveArrowDownOutline" />
          <p>
            <b>Archived.</b> {project.title} is now part of{" "}
            {replacement ? <a href={`${base}projects/${replacement.slug}/`}>{replacement.title}</a> : "another project"}:
            its repository is no longer updated. Install {replacement?.title ?? "it"} instead, which takes over its settings
            (<a href="https://github.com/juju35/ha-system-hub#migrating">how to migrate</a>).
          </p>
        </div>
      )}
      <p class="lead">{project.tagline}</p>
      <p class="summary muted">{project.summary}</p>
      <div class="actions">
        {!project.archived && <MarketplaceBadge project={project} class="head-cta" />}
        <a class="btn ghost" href={repoUrl(project)} target="_blank" rel="noopener">
          <Icon name="mdiGithub" /> GitHub
        </a>
        <a class="btn ghost" href="#install">
          <Icon name="mdiDownloadOutline" /> How to install
        </a>
        <button class="btn ghost share" type="button" data-title={project.title}>
          <Icon name="mdiShareVariantOutline" /> <span class="share-l">Share</span>
        </button>
        <a class="bmc" href="https://buymeacoffee.com/julienstep9" target="_blank" rel="noopener" aria-label="Buy me a coffee">
          <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="" width="143" height="40" loading="lazy" decoding="async" onerror="this.parentElement.classList.add('no-img')" />
          <span class="bmc-t" aria-hidden="true">☕ Buy me a coffee</span>
        </a>
      </div>
    </section>

    <!-- Section navigation, stays under the top bar -->
    <nav class="subnav" aria-label="On this page">
      <ProjectLogo project={project} size="sm" accent own />
      <span class="sn-title">{project.title}</span>
      <div class="sn-links">
        <a href="#overview" class="sn-link active" data-spy="overview">Overview</a>
        <a href="#install" class="sn-link" data-spy="install">Install</a>
        {hasNetworks && <a href="#cities" class="sn-link" data-spy="cities">Cities</a>}
        {hasGallery && <a href="#gallery" class="sn-link" data-spy="gallery">Gallery <span class="n">{shotCount}</span></a>}
        <a href="#documentation" class="sn-link" data-spy="documentation">Documentation</a>
        {changelog && <a href="#changelog" class="sn-link" data-spy="changelog">Changelog</a>}
      </div>
      {!project.archived && <MarketplaceBadge project={project} height={36} class="sn-cta" />}
    </nav>

    <!-- Hero + side column -->
    <div class="cols">
      <div class="hero-col">
        {
          project.hero ? (
            <button class="frame hero zoom" type="button" data-open-gallery style={heroStyle} aria-label={`Open the gallery: ${caption(project.hero)}`}>
              <Shot project={project} shot={project.hero} eager />
              {project.archived && (
                <span class="tapes" aria-hidden="true">
                  <span class="tape t1"><span>{"ARCHIVED · NO LONGER UPDATED · ".repeat(8)}</span></span>
                  <span class="tape t2"><span>{"ARCHIVED · DO NOT INSTALL · ".repeat(8)}</span></span>
                </span>
              )}
              {shotCount > 1 && <span class="hint"><Icon name="mdiImageMultiple" /> View all {shotCount}</span>}
            </button>
          ) : (
            <div class="ha-card hero empty">
              <ProjectLogo project={project} size="xl" accent own />
              <div class="empty-text">
                <div class="name">Runs in the background</div>
                <p class="muted">{project.title} has no dashboard of its own: it works on the server, with its entities, actions and notifications described in the documentation below.</p>
              </div>
              <a class="btn" style={accent} href="#documentation"><Icon name="mdiBookOpenPageVariantOutline" /> Read the documentation</a>
            </div>
          )
        }
      </div>

      <div class="side">
        <section class="ha-card pad">
          <h2 class="section-title"><Icon name="mdiStarFourPointsOutline" /> Highlights</h2>
          <ul class="highlights">
            {
              project.highlights.map((h) => (
                <li>
                  <span class="check" style={accent}><Icon name="mdiCheck" /></span>
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </section>

        {
          related.length > 0 && (
            <section class="ha-card pad">
              <h2 class="section-title"><Icon name="mdiPuzzleOutline" /> Works with</h2>
              <ul class="related">
                {related.map(({ p, why }) => (
                  <li>
                    <a class="rel-item tile" href={`${base}projects/${p.slug}/`}>
                      <ProjectLogo project={p} size="sm" accent />
                      <span class="titles">
                        <span class="name">{p.title}</span>
                        <span class="sub">{why}</span>
                      </span>
                      <Icon name="mdiChevronRight" class="arrow" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          brands.length > 0 && (
            <section class="ha-card pad">
              <h2 class="section-title"><Icon name="mdiTagMultipleOutline" /> Brands &amp; integrations</h2>
              <ul class="brands">
                {brands.slice(0, BRANDS_SHOWN).map((b) => (
                  <li class="brand tile" title={b.alt}>
                    <img src={b.src} alt="" loading="lazy" decoding="async" />
                    <span class="brand-name">{b.alt}</span>
                  </li>
                ))}
              </ul>
              {brands.length > BRANDS_SHOWN && (
                <details class="brands-more">
                  <summary class="btn">
                    <span class="when-closed"><Icon name="mdiChevronDown" /> Show all {brands.length}</span>
                    <span class="when-open"><Icon name="mdiChevronUp" /> Show fewer</span>
                  </summary>
                  <ul class="brands">
                    {brands.slice(BRANDS_SHOWN).map((b) => (
                      <li class="brand tile" title={b.alt}>
                        <img src={b.src} alt="" loading="lazy" decoding="async" />
                        <span class="brand-name">{b.alt}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          )
        }

        {
          cardTypes.length > 0 && (
            <section class="ha-card pad">
              <h2 class="section-title"><Icon name="mdiCardsOutline" /> Cards</h2>
              <div class="types">
                {cardTypes.map((t) => (
                  <span class="chip" style={accent}>{t}</span>
                ))}
              </div>
              <div class="code tile">
                <pre><code>{yaml}</code></pre>
                <button class="icon-btn copy" type="button" data-copy={yaml} aria-label="Copy YAML" title="Copy">
                  <Icon name="mdiContentCopy" class="i-copy" />
                  <Icon name="mdiCheck" class="i-done" />
                </button>
              </div>
            </section>
          )
        }

        <section class="ha-card pad" id="install">
          <h2 class="section-title"><Icon name="mdiDownloadOutline" /> Install</h2>
          <ol class="steps">
            <li>
              <span class="num" style={accent}>1</span>
              <span>
                Open the repository in the Marketplace with the <b>Add to Marketplace</b> button above, or add
                <code>{repoUrl(project).replace("https://", "")}</code> as a custom repository
                (category <b>{isCard ? "Dashboard" : "Integration"}</b>).
              </span>
            </li>
            <li>
              <span class="num" style={accent}>2</span>
              <span>Download it from the Marketplace.</span>
            </li>
            <li>
              <span class="num" style={accent}>3</span>
              <span>
                {
                  isCard
                    ? "Reload the browser and add the card from the dashboard editor."
                    : "Restart Home Assistant and add the integration from Settings → Devices & services."
                }
              </span>
            </li>
          </ol>
        </section>
      </div>
    </div>

    <Networks project={project} />

    <Gallery project={project} />

    <Docs project={project} />

    <!-- Prev / next -->
    <nav class="pager" aria-label="Other projects">
      <a class="ha-card nb" href={`${base}projects/${prev.slug}/`}>
        <Icon name="mdiChevronLeft" class="arrow" />
        <ProjectLogo project={prev} size="sm" accent />
        <span class="titles">
          <span class="sub">Previous</span>
          <span class="name">{prev.title}</span>
        </span>
      </a>
      <a class="ha-card nb right" href={`${base}projects/${next.slug}/`}>
        <span class="titles">
          <span class="sub">Next</span>
          <span class="name">{next.title}</span>
        </span>
        <ProjectLogo project={next} size="sm" accent />
        <Icon name="mdiChevronRight" class="arrow" />
      </a>
    </nav>
  </div>

</Base>

<p class="sr-only" id="announce" role="status" aria-live="polite"></p>

<script>
  const announce = (text: string) => {
    const el = document.getElementById("announce")!;
    el.textContent = "";
    requestAnimationFrame(() => (el.textContent = text));
  };

  // Share: the system share sheet when there is one, otherwise copy the link.
  for (const b of document.querySelectorAll<HTMLButtonElement>("button.share")) {
    b.addEventListener("click", async () => {
      const url = location.href.split("#")[0];
      try {
        if (navigator.share) await navigator.share({ title: b.dataset.title, url });
        else {
          await navigator.clipboard.writeText(url);
          const label = b.querySelector(".share-l")!;
          label.textContent = "Link copied";
          announce("Link copied");
          setTimeout(() => (label.textContent = "Share"), 1600);
        }
      } catch {}
    });
  }

  // One badge at a time: the bar's copy only shows once the header's has scrolled out of view.
  const headCta = document.querySelector(".head-cta");
  const subnav = document.querySelector(".subnav");
  if (headCta && subnav) {
    new IntersectionObserver(([e]) => subnav.classList.toggle("show-cta", !e.isIntersecting), {
      rootMargin: "-130px 0px 0px 0px",
    }).observe(headCta);
  }

  // Highlight the section in view in the section navigation.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".sn-link")];
  // In document order, so the last section scrolled past wins
  const targets = (links.map((l) => document.getElementById(l.dataset.spy!)).filter(Boolean) as HTMLElement[]).sort(
    (a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1),
  );
  const spy = () => {
    const y = 150;
    let current = targets[0]?.id;
    for (const t of targets) if (t.getBoundingClientRect().top <= y) current = t.id;
    if (innerHeight + scrollY >= document.body.scrollHeight - 4) current = targets[targets.length - 1]?.id;
    for (const l of links) l.classList.toggle("active", l.dataset.spy === current);
  };
  addEventListener("scroll", spy, { passive: true });
  spy();

  // Copy the YAML snippet.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
    let timer: number | undefined;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.classList.add("done");
        announce("Copied");
        clearTimeout(timer);
        timer = window.setTimeout(() => btn.classList.remove("done"), 1500);
      } catch {}
    });
  }

</script>

<style>
  .archived-chip {
    --c: #111; background: #f7d117; color: #111; font-weight: 700;
    border: 2px solid #111; letter-spacing: .06em; text-transform: uppercase;
  }
  /* Crime scene tape across the main screenshot of an archived project */
  .hero:has(.tapes) { overflow: hidden; }
  .hero:has(.tapes) :global(img) { filter: grayscale(.85) brightness(.92); }
  .tapes { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .tape {
    position: absolute; left: -20%; right: -20%; height: 44px;
    display: flex; align-items: center; overflow: hidden; white-space: nowrap;
    background: #f7d117; color: #111; box-shadow: 0 4px 14px rgba(0,0,0,.35);
    border-top: 4px solid #111; border-bottom: 4px solid #111;
    font: 800 18px/1 system-ui, sans-serif; letter-spacing: .16em;
  }
  .tape span { padding-left: 10px; }
  .t1 { top: 30%; transform: rotate(-8deg); }
  .t2 { top: 56%; transform: rotate(6deg); }
  .archived-banner {
    display: flex; gap: 12px; align-items: flex-start; margin: 0 0 4px; padding: 12px 14px; border-radius: 12px;
    background: color-mix(in srgb, var(--warning-color) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--warning-color) 45%, transparent);
  }
  .archived-banner svg { flex: none; width: 22px; height: 22px; color: var(--warning-color); }
  .archived-banner p { margin: 0; font-size: 14px; }

  .page { display: flex; flex-direction: column; gap: 24px; padding-top: 20px; padding-bottom: 8px; }

  .back {
    align-self: flex-start;
    display: inline-flex; align-items: center; gap: 4px;
    margin-left: -6px; padding: 4px 10px 4px 4px; border-radius: 16px;
    font-size: 14px; font-weight: 500;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .back svg { width: 20px; height: 20px; }
  .back:hover { color: var(--primary-text-color); background: var(--secondary-background-color); }

  /* Header card */
  .intro { padding: 24px; }
  .top { gap: 16px; flex-wrap: wrap; }
  h1 { margin: 0; font-size: 28px; font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; }
  .top .sub { font-size: 14px; margin-top: 2px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .lead { margin: 20px 0 6px; font-size: 18px; line-height: 1.45; max-width: 70ch; }
  .summary { margin: 0; max-width: 75ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 20px; }
  /* Buy Me a Coffee: the official button of the READMEs, 40px high and as round as the other buttons */
  .bmc { display: inline-flex; flex: none; border-radius: 20px; transition: filter 0.2s ease; }
  .bmc img { display: block; height: 40px; width: auto; border-radius: 20px; }
  .bmc:hover { filter: brightness(1.04); }
  .bmc:focus-visible { outline: 2px solid var(--focus-color); outline-offset: 2px; }
  /* If the image can't load: a yellow pill with the text */
  .bmc-t { display: none; align-items: center; height: 40px; padding: 0 16px; border-radius: 20px; background: #ffdd00; color: #000; font: 500 14px/1 var(--font); white-space: nowrap; }
  .bmc.no-img img { display: none; }
  .bmc.no-img .bmc-t { display: inline-flex; }

  /* Section navigation */
  .intro, #install { scroll-margin-top: 140px; }
  .subnav {
    position: sticky; top: 68px; z-index: 5;
    display: flex; align-items: center; gap: 10px;
    padding: 6px 6px 6px 10px; margin: -8px 0 -8px;
    background: color-mix(in srgb, var(--card-background-color) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border: 1px solid var(--divider-color); border-radius: 26px;
    box-shadow: var(--shadow);
  }
  .sn-title { font-weight: 500; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .sn-links { display: flex; gap: 2px; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
  .sn-links::-webkit-scrollbar { display: none; }
  .sn-link {
    flex: none; padding: 7px 12px; border-radius: 18px;
    font-size: 13px; font-weight: 500; color: var(--secondary-text-color);
    transition: background-color .2s ease, color .2s ease;
  }
  .sn-link .n { font-weight: 400; margin-left: 2px; }
  .sn-link:hover { color: var(--primary-text-color); }
  .sn-link.active { color: color-mix(in srgb, var(--c), var(--ink) var(--ink-amt)); background: color-mix(in srgb, var(--c) 14%, transparent); }
  /* Hidden while the header's badge is on screen (keeps its room in the bar, no jump) */
  .subnav :global(.sn-cta) { margin-left: 4px; opacity: 0; visibility: hidden; transition: opacity .2s ease, visibility .2s; }
  .subnav.show-cta :global(.sn-cta) { opacity: 1; visibility: visible; }

  /* Two columns */
  .cols { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .side { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .pad { padding: 16px 20px 20px; }
  .side h2 { margin-bottom: 14px; }

  /* Screenshot frames: blend with the padding already in the screenshots */
  .frame {
    all: unset;
    display: block; width: 100%; box-sizing: border-box;
    background: var(--primary-background-color);
    border: 1px solid var(--divider-color);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.3s ease;
  }
  /* At most the capture's own size, centred on the frame (whose colour is the capture's background) */
  .frame :global(img) { width: 100%; max-width: var(--shot-w, 100%); height: auto; margin-inline: auto; }
  .zoom { cursor: zoom-in; }
  .zoom:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .zoom:focus-visible { outline: 2px solid var(--focus-color); outline-offset: 2px; }
  .hero-col { position: sticky; top: 136px; min-width: 0; }
  .hero { position: relative; }
  /* Portrait captures: framed from the top, the whole capture is one click away */
  .hero:has(:global(img[data-tall])) { max-height: min(72vh, 760px); }
  .hero :global(img[data-tall]) { mask-image: linear-gradient(#000 calc(100% - 140px), transparent); }
  .hint {
    position: absolute; right: 12px; bottom: 12px; z-index: 1;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 16px;
    font-size: 13px; font-weight: 500; color: var(--primary-text-color);
    background: color-mix(in srgb, var(--card-background-color) 85%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--divider-color);
    opacity: 0; transform: translateY(4px); transition: opacity .2s ease, transform .2s ease;
  }
  .hint :global(svg) { width: 16px; height: 16px; }
  .hero:hover .hint, .hero:focus-visible .hint, .hero:has(:global(img[data-tall])) .hint { opacity: 1; transform: none; }
  .hero.empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    min-height: 320px; padding: 32px; text-align: center;
    background:
      radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--c) 14%, transparent), transparent 60%),
      var(--card-background-color);
  }
  /* Brands & integrations: a grid of logo tiles, the name under each logo */
  .brands { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px; }
  .brand { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px 6px; text-align: center; min-width: 0; }
  /* On a white chip, so dark logos stay readable in the dark theme */
  .brand img { height: 40px; width: auto; min-width: 40px; max-width: 80px; object-fit: contain; padding: 4px; box-sizing: border-box; background: #fff; border-radius: 10px; }
  /* The rest of the brands below the first ones, the button after them */
  .brands-more { display: flex; flex-direction: column; }
  .brands-more > ul { margin-top: 8px; }
  .brands-more > summary { order: 2; list-style: none; align-self: center; margin-top: 12px; cursor: pointer; }
  .brands-more > summary::-webkit-details-marker { display: none; }
