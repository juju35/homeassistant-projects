---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Languages from "../components/Languages.astro";
import MadeIn from "../components/MadeIn.astro";
import Support from "../components/Support.astro";
import Scene from "../components/Scene.astro";
import { archived, categories, contributors, contributorsByLogin, current, projects, OWNER } from "../lib/projects";
import { kindCounts } from "../lib/kinds";
import ProjectLogo from "../components/ProjectLogo.astro";
import { news } from "../lib/whats-new";
import { headline } from "../lib/news.mjs";
import { formatDate } from "../lib/releases";

const counts = kindCounts(current);
const cards = counts.card;
const integrations = counts.integration;
const themes = counts.theme;
// en, fr, de, es, it, nl, pt, pl, sr (Cyrillic), sr-Latn, ro, da, sv, bg, ru, uk, hu, sk, cs, sl, lv
// and el
const LANGUAGES = 22;
const base = import.meta.env.BASE_URL;
const animations = current.reduce((n, p) => n + (p.animations?.length ?? 0), 0);
// Within a category (and in Archived), projects in alphabetical order of their name
const byTitle = (a: { title: string }, b: { title: string }) =>
  a.title.localeCompare(b.title, "en", { sensitivity: "base", numeric: true });
// The six latest versions, one per project
const latest = await news(6);
const groups = categories
  .map((c) => ({ ...c, items: current.filter((p) => p.category === c.id).sort(byTitle) }))
  .filter((g) => g.items.length);
---

<Base
  title="Home Assistant projects"
  description={`${cards} Lovelace cards, ${integrations} custom integrations and ${themes} ${themes === 1 ? "theme" : "themes"} for Home Assistant, all installable from the Marketplace.`}
>
  <section class="wrap hero">
    <div class="ha-card hero-card" style="--c:var(--primary-color)">
      <Scene icons={["mdiHomeOutline", "mdiSolarPanel", "mdiCarHatchback"]} class="no-fold">
        <span class="logo"><Icon name="mdiHomeAssistant" /></span>
        <div class="titles">
          <div class="hero-title">
            <h1>Home Assistant projects</h1>
            <span class="status-dot" title="All maintained"></span>
          </div>
          <div class="sub hero-sub kind-line" style="--k:var(--success-color)">All on the Marketplace · by {OWNER}</div>
        </div>
      </Scene>
      <div class="hero-body">
      <p class="lead">
        Dashboard cards that look at home in Home Assistant and find their entities by themselves,
        and integrations that keep things quiet until something really needs you. Light and dark themes,
        22 languages: Français, English, Deutsch, Español, Italiano, Nederlands, Português, Polski,
        Српски, Srpski, Română, Dansk, Svenska, Български, Русский, Українська, Magyar,
        Slovenčina, Čeština, Slovenščina, Latviešu and Ελληνικά.
      </p>
      <p class="stats-inline muted">{cards} cards · {integrations} integrations · {themes} {themes === 1 ? "theme" : "themes"} · {animations} animations · {LANGUAGES} languages</p>
      <div class="stats">
        <div class="tile stat" style="--c:#5b6cf0">
          <span class="logo"><Icon name="mdiViewDashboardVariant" /></span>
          <div><div class="v">{cards}</div><div class="sub">Cards</div></div>
        </div>
        <div class="tile stat" style="--c:#26a69a">
          <span class="logo"><Icon name="mdiPuzzle" /></span>
          <div><div class="v">{integrations}</div><div class="sub">Integrations</div></div>
        </div>
        <div class="tile stat" style="--c:#78909c">
          <span class="logo"><Icon name="mdiThemeLightDark" /></span>
          <div><div class="v">{themes}</div><div class="sub">{themes === 1 ? "Theme" : "Themes"}</div></div>
        </div>
        <div class="tile stat" style="--c:#f5a623">
          <span class="logo"><Icon name="mdiAnimationPlay" /></span>
          <div><div class="v">{animations}</div><div class="sub">Animations</div></div>
        </div>
        <div class="tile stat" style="--c:#41bdf5">
          <span class="logo"><Icon name="mdiTranslate" /></span>
          <div><div class="v">{LANGUAGES}</div><div class="sub">Languages</div></div>
        </div>
      </div>
      </div>
    </div>
    <aside class="ha-card notice" aria-labelledby="notice-title">
      <span class="logo" style="--c:var(--warning-color)"><Icon name="mdiArchiveArrowDownOutline" /></span>
      <div>
        <h2 id="notice-title" class="notice-title">Six projects are now part of System Hub</h2>
        <p class="muted">
          The System Monitor cards, Marketplace Refresh, Integration Watchdog, Battery Monitor, Git Sync and Orphan
          Entities are modules of <a href={`${base}projects/ha-system-hub/`}>System Hub</a>. Their repositories are
          archived and no longer updated. A module turned on in System Hub takes over the settings of the integration
          it replaces, and a repair reminds you to remove the old one.
          They are listed under <a href="#archived">Archived</a>. <a href="https://github.com/juju35/ha-system-hub#migrating">How to migrate</a>
        </p>
      </div>
    </aside>
  </section>

  {latest.length > 0 && (
    <section class="wrap news" aria-labelledby="news-title">
      <div class="news-head">
        <h2 class="section-title" id="news-title"><Icon name="mdiNewBox" />What's new</h2>
        <a class="feed muted" href={`${base}releases.xml`} title="Atom feed of the new versions"><Icon name="mdiRss" />Feed</a>
      </div>
      <ul class="news-list">
        {latest.map((n) => (
          <li class="tile news-item" style={`--c:${n.project.accent}`}>
            <ProjectLogo project={n.project} size="sm" />
            <div class="news-text">
              <a class="news-link" href={`${base}projects/${n.project.slug}/#${n.anchor}`}>
                <span class="news-name">{n.title}</span>
                <span class="chip news-v" style={`--c:${n.project.accent}`}>{n.version}</span>
              </a>
              <span class="news-when muted">{formatDate(`${n.date}T00:00:00Z`)}</span>
              <span class="news-line">{headline(n.html)}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="sticky">
  <section class="wrap toolbar" aria-label="Filter projects">
    <div class="segmented" role="group" aria-label="Type">
      <button class="seg active" type="button" data-filter="all" aria-pressed="true"><Icon name="mdiViewGridOutline" class="seg-i" /><span class="seg-l">All</span> <span class="n">{current.length}</span></button>
      <button class="seg" type="button" data-filter="card" aria-pressed="false"><Icon name="mdiViewDashboardVariant" class="seg-i" /><span class="seg-l">Cards</span> <span class="n">{cards}</span></button>
      <button class="seg" type="button" data-filter="integration" aria-pressed="false"><Icon name="mdiPuzzle" class="seg-i" /><span class="seg-l">Integrations</span> <span class="n">{integrations}</span></button>
      <button class="seg" type="button" data-filter="theme" aria-pressed="false"><Icon name="mdiThemeLightDark" class="seg-i" /><span class="seg-l">Themes</span> <span class="n">{themes}</span></button>
    </div>
    <button class="sort-btn" type="button" id="sort" aria-pressed="false" title="Sort by popularity (downloads, then stars)">
      <Icon name="mdiSortAlphabeticalAscending" class="sort-az" /><Icon name="mdiFire" class="sort-pop" /><span class="sort-l">A–Z</span>
    </button>
    <label class="search tile">
      <Icon name="mdiMagnify" />
      <input type="search" id="q" placeholder="Search projects, brands, features" autocomplete="off" aria-label="Search a card or an integration" />
      <kbd class="kbd" aria-hidden="true">/</kbd>
    </label>
  </section>
  <p class="sr-only" id="results" role="status" aria-live="polite"></p>

  <nav class="wrap jump" aria-label="Categories">
    {groups.map((g) => (
      <a class="chip neutral" href={`#${g.id}`}><Icon name={g.icon} />{g.label}</a>
    ))}
    <a class="chip neutral to-brands" href={`${base}brands/`}><Icon name="mdiTagMultipleOutline" />Brands</a>
  </nav>
  </div>
  <nav class="wrap jump below" aria-label="Categories">
    {groups.map((g) => (
      <a class="chip neutral" href={`#${g.id}`}><Icon name={g.icon} />{g.label}</a>
    ))}
    <a class="chip neutral to-brands" href={`${base}brands/`}><Icon name="mdiTagMultipleOutline" />Brands</a>
  </nav>

  <div class="wrap">
    <!-- One card per category: its illustrated header folds and unfolds it (chevron right folded, down unfolded) -->
    {groups.map((g) => (
      <section class="ha-card group" id={g.id} data-group style={`--c:${g.accent}`}>
        <h2 class="group-h">
          <button class="group-toggle" type="button" aria-expanded="true" aria-controls={`${g.id}-items`}>
            <Scene icons={g.scene}>
              <span class="logo"><Icon name={g.icon} /></span>
              <span class="titles">
                <span class="group-name">{g.label}<span class="status-dot"></span></span>
                <span class="sub kind-line" style={`--k:${g.accent}`}><span class="count">{g.items.length}</span> projects</span>
              </span>
              <span class="fold-btn" aria-hidden="true"><Icon name="mdiChevronRight" /></span>
            </Scene>
          </button>
        </h2>
        <div class="group-body" id={`${g.id}-items`}>
          <div class="grid">
            {g.items.map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </section>
    ))}
    {archived.length > 0 && (
      <section class="ha-card group archived-group" id="archived" data-group style="--c:#6b7280">
        <h2 class="group-h">
          <button class="group-toggle" type="button" aria-expanded="true" aria-controls="archived-items">
            <Scene icons={["mdiArchiveOutline", "mdiPackageVariantClosed", "mdiServer"]}>
              <span class="logo"><Icon name="mdiArchiveOutline" /></span>
              <span class="titles">
                <span class="group-name">Archived<span class="status-dot off"></span></span>
                <span class="sub"><span class="count">{archived.length}</span> projects · no longer updated</span>
              </span>
              <span class="fold-btn" aria-hidden="true"><Icon name="mdiChevronRight" /></span>
            </Scene>
          </button>
        </h2>
        <div class="group-body" id="archived-items">
          <p class="muted archived-note">
            These projects are now modules of <a href={`${base}projects/ha-system-hub/`}>System Hub</a>.
          </p>
          <div class="grid">
            {[...archived].sort(byTitle).map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </section>
    )}
    <div class="empty" id="empty" hidden>
      <span class="logo lg"><Icon name="mdiMagnifyClose" /></span>
      <p class="muted" id="empty-text">No project matches this search.</p>
      <button class="btn ghost" type="button" id="clear"><Icon name="mdiFilterRemoveOutline" /> Clear filters</button>
    </div>

    <Languages />
    <MadeIn />
    <Support />

    <section class="contrib" id="contributing" aria-labelledby="contributing-title">
      <h2 class="section-title" id="contributing-title"><Icon name="mdiHandHeartOutline" />Contributions</h2>
      <div class="ha-card contrib-card">
        {contributors.length > 0 && (
          <div class="people">
            <h3 class="contrib-h">Thanks to</h3>
            <ul class="people-list">
              {contributorsByLogin().map((c) => (
                  <li class="person tile">
                  <span class="avatar" aria-hidden="true">
                    {c.login[0].toUpperCase()}
                    <img src={`https://github.com/${c.login}.png?size=96`} alt="" width="40" height="40" loading="lazy" decoding="async" onerror="this.remove()" />
                  </span>
                  <span class="who">
                    <a class="login" href={`https://github.com/${c.login}`} target="_blank" rel="noopener">@{c.login}</a>
                    {c.items.map((item) => {
                      const p = item.project ? projects.find((x) => x.slug === item.project) : undefined;
                      return (
                        <span class="muted">
                          {item.contribution}
                          {p && <> · <a class="on" href={`${import.meta.env.BASE_URL}projects/${p.slug}/`}>{p.title}</a></>}
                        </span>
                      );
                    })}
                  </span>
                  </li>
              ))}
            </ul>
          </div>
        )}
        <div class="ways">
          <h3 class="contrib-h">Want to help?</h3>
          <div class="ways-grid">
            <div class="way" style="--c:#41bdf5">
              <span class="logo sm"><Icon name="mdiTranslate" /></span>
              <div><b>Translate</b><p class="muted">Each card and integration keeps its texts in one file per language: add yours in a pull request on its repository.</p></div>
            </div>
            <div class="way" style="--c:#db4437">
              <span class="logo sm"><Icon name="mdiBugOutline" /></span>
              <div><b>Report a bug</b><p class="muted">Open an issue on the project's repository, with your Home Assistant version and what you see.</p></div>
            </div>
            <div class="way" style="--c:#f5a623">
              <span class="logo sm"><Icon name="mdiLightbulbOnOutline" /></span>
              <div><b>Suggest an idea</b><p class="muted">A brand to support, an option, a new card: issues are open for ideas too.</p></div>
            </div>
          </div>
          <a class="btn ghost repos" href={`https://github.com/${OWNER}?tab=repositories`} target="_blank" rel="noopener"><Icon name="mdiGithub" /> Every repository on GitHub</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { inFilter } from "../lib/kinds";
  {
    let kind = "all";
    const q = document.getElementById("q") as HTMLInputElement;
    const cards = [...document.querySelectorAll<HTMLElement>(".project")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const jumps = [...document.querySelectorAll<HTMLAnchorElement>(".jump a")];
    const segs = [...document.querySelectorAll<HTMLButtonElement>(".seg")];
    // Category cards fold from their illustrated header
    const setOpen = (g: HTMLElement, open: boolean) => {
      g.querySelector(".group-toggle")?.setAttribute("aria-expanded", String(open));
      const body = g.querySelector<HTMLElement>(".group-body");
      if (body) body.hidden = !open;
    };
    for (const g of groups) {
      g.querySelector(".group-toggle")?.addEventListener("click", (e) =>
        setOpen(g, (e.currentTarget as HTMLElement).getAttribute("aria-expanded") !== "true"),
      );
    }
    // A category chip or a #category link unfolds its card
    const openFromHash = (hash: string) => {
      const g = groups.find((x) => `#${x.id}` === hash);
      if (g) setOpen(g, true);
    };
    for (const a of jumps) a.addEventListener("click", () => openFromHash(a.getAttribute("href")!));
    addEventListener("hashchange", () => openFromHash(location.hash));
    openFromHash(location.hash);
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      // Every word must match the start of a word somewhere (name, description, brands, doc headings…), accents ignored
      const words = term.normalize("NFD").replace(/[\u0300-\u036f]/g, "").split(/\s+/).filter(Boolean);
      const matches = (c: HTMLElement) => words.every((w) => (" " + c.dataset.search!).includes(" " + w));
      const isKind = (c: HTMLElement, k: string) => inFilter(c.dataset.kind!, k);
      // Archived projects are listed apart and left out of the counts (see SSR kindCounts(current))
      const isLive = (c: HTMLElement) => !c.classList.contains("archived");
      for (const c of cards) c.hidden = !(isKind(c, kind) && matches(c));
      // Counts on the type buttons follow the search
      for (const b of segs) b.querySelector(".n")!.textContent = String(cards.filter((c) => isLive(c) && isKind(c, b.dataset.filter!) && matches(c)).length);
      const shownTotal = cards.filter((c) => isLive(c) && !c.hidden).length;
      document.getElementById("results")!.textContent = `${shownTotal} project${shownTotal === 1 ? "" : "s"}`;
      let any = false;
      groups.forEach((g) => {
        const shown = g.querySelectorAll(".project:not([hidden])").length;
        g.hidden = !shown;
        // A search or a type filter unfolds the cards it finds something in
        if (shown && (term || kind !== "all")) setOpen(g, true);
        for (const a of jumps) if (a.getAttribute("href") === `#${g.id}`) a.hidden = !shown;
        g.querySelector(".count")!.textContent = String(shown);
        any ||= !!shown;
      });
      document.getElementById("empty")!.hidden = any;
      // Shareable: ?kind=card&q=nas (replaceState, so typing doesn't flood the history)
      const url = new URL(location.href);
      kind === "all" ? url.searchParams.delete("kind") : url.searchParams.set("kind", kind);
      term ? url.searchParams.set("q", q.value.trim()) : url.searchParams.delete("q");
      history.replaceState(null, "", url);
      const label = ({ card: "cards", integration: "integrations", theme: "themes" } as Record<string, string>)[kind];
      document.getElementById("empty-text")!.textContent =
        `No ${label ?? "project"} ${term ? `matches “${q.value.trim()}”` : "here"}.`;
    };
    document.getElementById("clear")!.addEventListener("click", () => {
      q.value = "";
      document.querySelector<HTMLButtonElement>('.seg[data-filter="all"]')!.click();
    });
    segs.forEach((b) =>
      b.addEventListener("click", () => {
        segs.forEach((x) => {
          x.classList.toggle("active", x === b);
          x.setAttribute("aria-pressed", String(x === b));
        });
        kind = b.dataset.filter!;
        apply();
      }),
    );
    q.addEventListener("input", apply);
    // Sort: A–Z (the order of the page) or popular (release downloads, then GitHub stars)
    const sortBtn = document.getElementById("sort") as HTMLButtonElement;
    const grids = [...document.querySelectorAll<HTMLElement>(".grid")];
    grids.forEach((g) => [...g.children].forEach((c, i) => ((c as HTMLElement).dataset.i = String(i))));
    const num = (c: Element, k: string) => Number((c as HTMLElement).dataset[k] ?? 0);
    const setSort = (popular: boolean) => {
      sortBtn.setAttribute("aria-pressed", String(popular));
      sortBtn.title = popular ? "Sorted by popularity: sort A–Z" : "Sort by popularity (downloads, then stars)";
      sortBtn.querySelector(".sort-l")!.textContent = popular ? "Popular" : "A–Z";
      for (const g of grids)
        g.append(...[...g.children].sort((a, b) =>
          popular ? num(b, "dl") - num(a, "dl") || num(b, "stars") - num(a, "stars") || num(a, "i") - num(b, "i") : num(a, "i") - num(b, "i"),
        ));
      const url = new URL(location.href);
      popular ? url.searchParams.set("sort", "popular") : url.searchParams.delete("sort");
      history.replaceState(null, "", url);
    };
    sortBtn.addEventListener("click", () => setSort(sortBtn.getAttribute("aria-pressed") !== "true"));
    if (new URLSearchParams(location.search).get("sort") === "popular") setSort(true);
    // Restore the filters from the URL
    const params = new URLSearchParams(location.search);
    const k = params.get("kind");
    if (params.get("q")) q.value = params.get("q")!;
    if (k === "card" || k === "integration" || k === "theme") document.querySelector<HTMLButtonElement>(`.seg[data-filter="${k}"]`)!.click();
    else if (q.value) apply();
    // "/" focuses the search, Escape clears it
    addEventListener("keydown", (e) => {
      if (e.key === "/" && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? "")) {
        e.preventDefault();
        q.focus();
      }
    });
    q.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && q.value) { q.value = ""; apply(); }
    });
    // Divider under the filters once they stick under the top bar
    const bar = document.querySelector(".sticky")!;
    const onScroll = () => bar.classList.toggle("stuck", bar.getBoundingClientRect().top <= 62);
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .hero { padding-top: 24px; }
  .hero-card { overflow: hidden; }
  .hero-title { display: flex; align-items: center; gap: 10px; }
  .hero-body { padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 16px; }
  h1 { margin: 0; font-size: clamp(20px, 3.2vw, 24px); font-weight: 500; line-height: 1.15; letter-spacing: -0.01em; }
  .hero-sub { font-size: 13px; margin-top: 2px; }
  .lead { margin: 0; max-width: 70ch; color: var(--secondary-text-color); font-size: 15px; }
  .stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .stat { display: flex; align-items: center; gap: 12px; padding: 12px; }
  .stat .v { font-size: 22px; font-weight: 500; line-height: 1.1; }
  .stats-inline { display: none; margin: -4px 0 0; font-size: 13px; }
  .notice { margin-top: 12px; padding: 16px 20px; display: flex; gap: 14px; align-items: flex-start; }
  .notice .logo { flex: none; }
  .notice-title { margin: 2px 0 4px; font-size: 16px; font-weight: 500; }
  .notice p { margin: 0; font-size: 14px; max-width: 80ch; }
  .archived-note { font-size: 14px; }

  /* What's new: the six latest versions, the whole tile opens the version on its project page */
  .news { margin-top: 16px; }
  .news-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .news-head .section-title { margin: 0; }
  .feed { display: inline-flex; align-items: center; gap: 4px; font-size: 13px; }
  .feed:hover { color: var(--primary-text-color); }
  .feed :global(svg) { width: 16px; height: 16px; color: #f26522; }
  .news-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .news-item { position: relative; display: flex; gap: 12px; align-items: flex-start; padding: 12px; transition: background-color .2s ease; }
  .news-item:hover { background: color-mix(in srgb, var(--c) 8%, var(--secondary-background-color)); }
  .news-item :global(.logo) { flex: none; }
  .news-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .news-link { display: flex; align-items: center; gap: 8px; color: inherit; outline: none; min-width: 0; }
  .news-link::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .news-item:has(.news-link:focus-visible) { outline: 2px solid var(--focus-color); outline-offset: 2px; }
  .news-name { font-weight: 500; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .news-v { flex: none; padding: 1px 8px; font-size: 12px; }
  .news-when { font-size: 12px; }
  .news-line {
    font-size: 13px; line-height: 1.4; color: var(--secondary-text-color); margin-top: 2px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  @media (max-width: 900px) { .news-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Phones: one row that scrolls sideways */
  @media (max-width: 600px) {
    .news-list {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px;
    }
    .news-list::-webkit-scrollbar { display: none; }
    .news-item { flex: 0 0 82%; scroll-snap-align: start; }
  }

  /* Filters stay under the top bar while scrolling */
  .sticky {
    position: sticky; top: 61px; z-index: 5; margin-top: 16px; padding: 10px 0 12px;
    background: color-mix(in srgb, var(--primary-background-color) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent; transition: border-color .2s ease;
  }
  .sticky.stuck { border-bottom-color: var(--divider-color); }
  .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .segmented {
