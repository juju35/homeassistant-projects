---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { categories, projects, OWNER } from "../lib/projects";

const cards = projects.filter((p) => p.kind === "card").length;
const integrations = projects.length - cards;
const animations = projects.reduce((n, p) => n + (p.animations?.length ?? 0), 0);
const groups = categories
  .map((c) => ({ ...c, items: projects.filter((p) => p.category === c.id) }))
  .filter((g) => g.items.length);
---

<Base
  title="Home Assistant projects"
  description={`${cards} Lovelace cards and ${integrations} custom integrations for Home Assistant, all installable with HACS.`}
>
  <section class="wrap hero">
    <div class="ha-card hero-card">
      <div class="header">
        <span class="logo lg" style="--c:#41bdf5"><Icon name="mdiHomeAssistant" /></span>
        <div class="titles">
          <h1>Home Assistant projects</h1>
          <div class="sub hero-sub">Custom cards and integrations by {OWNER}</div>
        </div>
        <span class="chip status" style="--c:var(--success-color)"><span class="dot"></span>All HACS-ready</span>
      </div>
      <p class="lead">
        Dashboard cards that look at home in Home Assistant and find their entities by themselves,
        and integrations that keep things quiet until something really needs you. Light and dark themes,
        English, French, German and Spanish.
      </p>
      <p class="stats-inline muted">{cards} cards · {integrations} integrations · {animations} animations · 4 languages</p>
      <div class="stats">
        <div class="tile stat" style="--c:#5b6cf0">
          <span class="logo"><Icon name="mdiViewDashboardVariant" /></span>
          <div><div class="v">{cards}</div><div class="sub">Cards</div></div>
        </div>
        <div class="tile stat" style="--c:#26a69a">
          <span class="logo"><Icon name="mdiPuzzle" /></span>
          <div><div class="v">{integrations}</div><div class="sub">Integrations</div></div>
        </div>
        <div class="tile stat" style="--c:#f5a623">
          <span class="logo"><Icon name="mdiAnimationPlay" /></span>
          <div><div class="v">{animations}</div><div class="sub">Animations</div></div>
        </div>
        <div class="tile stat" style="--c:#41bdf5">
          <span class="logo"><Icon name="mdiTranslate" /></span>
          <div><div class="v">4</div><div class="sub">Languages</div></div>
        </div>
      </div>
    </div>
  </section>

  <div class="sticky">
  <section class="wrap toolbar" aria-label="Filter projects">
    <div class="segmented" role="group" aria-label="Type">
      <button class="seg active" type="button" data-filter="all" aria-pressed="true"><Icon name="mdiViewGridOutline" class="seg-i" /><span class="seg-l">All</span> <span class="n">{projects.length}</span></button>
      <button class="seg" type="button" data-filter="card" aria-pressed="false"><Icon name="mdiViewDashboardVariant" class="seg-i" /><span class="seg-l">Cards</span> <span class="n">{cards}</span></button>
      <button class="seg" type="button" data-filter="integration" aria-pressed="false"><Icon name="mdiPuzzle" class="seg-i" /><span class="seg-l">Integrations</span> <span class="n">{integrations}</span></button>
    </div>
    <label class="search tile">
      <Icon name="mdiMagnify" />
      <input type="search" id="q" placeholder="Search a card or an integration" autocomplete="off" aria-label="Search a card or an integration" />
      <kbd class="kbd" aria-hidden="true">/</kbd>
    </label>
  </section>
  <p class="sr-only" id="results" role="status" aria-live="polite"></p>

  <nav class="wrap jump" aria-label="Categories">
    {groups.map((g) => (
      <a class="chip neutral" href={`#${g.id}`}><Icon name={g.icon} />{g.label}</a>
    ))}
  </nav>
  </div>
  <nav class="wrap jump below" aria-label="Categories">
    {groups.map((g) => (
      <a class="chip neutral" href={`#${g.id}`}><Icon name={g.icon} />{g.label}</a>
    ))}
  </nav>

  <div class="wrap">
    {groups.map((g) => (
      <section class="group" id={g.id} data-group>
        <h2 class="section-title"><Icon name={g.icon} />{g.label}<span class="count">{g.items.length}</span></h2>
        <div class="grid">
          {g.items.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    ))}
    <div class="empty" id="empty" hidden>
      <span class="logo lg"><Icon name="mdiMagnifyClose" /></span>
      <p class="muted" id="empty-text">No project matches this search.</p>
      <button class="btn ghost" type="button" id="clear"><Icon name="mdiFilterRemoveOutline" /> Clear filters</button>
    </div>
  </div>
</Base>

<script is:inline>
  (() => {
    let kind = "all";
    const q = document.getElementById("q");
    const cards = [...document.querySelectorAll(".project")];
    const groups = [...document.querySelectorAll("[data-group]")];
    const jumps = [...document.querySelectorAll(".jump a")];
    const segs = [...document.querySelectorAll(".seg")];
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      // Every word must match somewhere (name, description, brands, integration names…), accents ignored
      const words = term.normalize("NFD").replace(/[\u0300-\u036f]/g, "").split(/\s+/).filter(Boolean);
      const matches = (c) => words.every((w) => c.dataset.search.includes(w));
      const isKind = (c, k) => k === "all" || c.dataset.kind === k || (k === "card" && c.dataset.withCard);
      for (const c of cards) c.hidden = !(isKind(c, kind) && matches(c));
      // Counts on the type buttons follow the search
      for (const b of segs) b.querySelector(".n").textContent = cards.filter((c) => isKind(c, b.dataset.filter) && matches(c)).length;
      const shownTotal = cards.filter((c) => !c.hidden).length;
      document.getElementById("results").textContent = `${shownTotal} project${shownTotal === 1 ? "" : "s"}`;
      let any = false;
      groups.forEach((g) => {
        const shown = g.querySelectorAll(".project:not([hidden])").length;
        g.hidden = !shown;
        for (const a of jumps) if (a.getAttribute("href") === `#${g.id}`) a.hidden = !shown;
        g.querySelector(".count").textContent = shown;
        any ||= !!shown;
      });
      document.getElementById("empty").hidden = any;
      // Shareable: ?kind=card&q=nas (replaceState, so typing doesn't flood the history)
      const url = new URL(location.href);
      kind === "all" ? url.searchParams.delete("kind") : url.searchParams.set("kind", kind);
      term ? url.searchParams.set("q", q.value.trim()) : url.searchParams.delete("q");
      history.replaceState(null, "", url);
      const label = { card: "cards", integration: "integrations" }[kind];
      document.getElementById("empty-text").textContent =
        `No ${label ?? "project"} ${term ? `matches “${q.value.trim()}”` : "here"}.`;
    };
    document.getElementById("clear").addEventListener("click", () => {
      q.value = "";
      document.querySelector('.seg[data-filter="all"]').click();
    });
    document.querySelectorAll(".seg").forEach((b) =>
      b.addEventListener("click", () => {
        segs.forEach((x) => {
          x.classList.toggle("active", x === b);
          x.setAttribute("aria-pressed", x === b);
        });
        kind = b.dataset.filter;
        apply();
      }),
    );
    q.addEventListener("input", apply);
    // Restore the filters from the URL
    const params = new URLSearchParams(location.search);
    const k = params.get("kind");
    if (params.get("q")) q.value = params.get("q");
    if (k === "card" || k === "integration") document.querySelector(`.seg[data-filter="${k}"]`).click();
    else if (q.value) apply();
    // "/" focuses the search, Escape clears it
    addEventListener("keydown", (e) => {
      if (e.key === "/" && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? "")) {
        e.preventDefault();
        q.focus();
      }
    });
    q.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && q.value) { q.value = ""; apply(); }
    });
    // Divider under the filters once they stick under the top bar
    const bar = document.querySelector(".sticky");
    const onScroll = () => bar.classList.toggle("stuck", bar.getBoundingClientRect().top <= 62);
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  .hero { padding-top: 24px; }
  .hero-card { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
  .hero-card .header { align-items: flex-start; }
  h1 { margin: 2px 0 0; font-size: clamp(24px, 4vw, 32px); font-weight: 500; line-height: 1.15; letter-spacing: -0.01em; }
  .hero-sub { font-size: 14px; margin-top: 4px; }
  .status { margin-top: 6px; }
  .lead { margin: 0; max-width: 70ch; color: var(--secondary-text-color); font-size: 15px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .stat { display: flex; align-items: center; gap: 12px; padding: 12px; }
  .stat .v { font-size: 22px; font-weight: 500; line-height: 1.1; }
  .stats-inline { display: none; margin: -4px 0 0; font-size: 13px; }

  /* Filters stay under the top bar while scrolling */
  .sticky {
    position: sticky; top: 61px; z-index: 5; margin-top: 16px; padding: 10px 0 12px;
    background: color-mix(in srgb, var(--primary-background-color) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent; transition: border-color .2s ease;
  }
  .sticky.stuck { border-bottom-color: var(--divider-color); }
  .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .segmented {
    display: inline-flex; gap: 4px; padding: 4px;
    background: var(--card-background-color);
    border: 1px solid var(--divider-color);
    border-radius: 22px;
  }
  .seg {
    all: unset; cursor: pointer;
    padding: 6px 14px; border-radius: 18px;
    font-size: 14px; font-weight: 500; color: var(--secondary-text-color);
    transition: background-color .2s ease, color .2s ease;
  }
  .seg { display: inline-flex; align-items: center; gap: 4px; }
  .seg .n { font-weight: 400; opacity: .7; }
  .seg-i { width: 16px; height: 16px; display: none; }
  .seg:hover { color: var(--primary-text-color); }
  .seg.active { color: var(--primary-color); background: color-mix(in srgb, var(--primary-color) 14%, transparent); }
  .seg:focus-visible { outline: 2px solid var(--primary-color); outline-offset: 1px; }
  .search {
    flex: 1; min-width: 220px; max-width: 420px; margin-left: auto;
    display: flex; align-items: center; gap: 8px;
    height: 40px; padding: 0 14px; border-radius: 20px;
    background: var(--card-background-color); border: 1px solid var(--divider-color);
    color: var(--secondary-text-color);
  }
  .search svg { width: 20px; height: 20px; flex: none; }
  .search input { all: unset; flex: 1; min-width: 0; font-size: 14px; color: var(--primary-text-color); }
  .search:focus-within { border-color: var(--primary-color); }
  .kbd {
    flex: none; font: 500 11px/1 var(--font); padding: 3px 7px; border-radius: 6px;
    color: var(--secondary-text-color); border: 1px solid var(--divider-color);
  }
  .search:focus-within .kbd { display: none; }
  @media (hover: none) { .kbd { display: none; } }

  .jump { display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; scrollbar-width: none; }
  .jump::-webkit-scrollbar { display: none; }
  .jump .chip { flex: none; }
  .jump.below { display: none; }
  .jump .chip { padding: 4px 12px; font-size: 13px; transition: background-color .2s ease; }
  .jump .chip:hover { background: color-mix(in srgb, var(--secondary-text-color) 22%, transparent); }

  .group { margin-top: 24px; scroll-margin-top: 190px; }
  .count {
    font-size: 12px; letter-spacing: 0; text-transform: none;
    padding: 0 8px; border-radius: 10px; background: var(--card-background-color); border: 1px solid var(--divider-color);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .empty { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 56px 0; text-align: center; }
  .empty p { margin: 0; }
  .empty .logo { --c: var(--secondary-text-color); }

  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat .sub { white-space: nowrap; }
    .status { display: none; }
    .search { max-width: none; margin-left: 0; }
  }
  @media (max-width: 380px) { .grid { grid-template-columns: 1fr; } }
  /* Phones: the filters scroll with the page instead of taking a quarter of the screen,
     bigger touch targets, and a fade hinting that the category row scrolls */
  /* Phones: a short header, and only one compact row (type icons + search) stays under the top bar */
  @media (max-width: 600px) {
    .hero { padding-top: 12px; }
    .hero-card { padding: 16px; gap: 12px; }
    .lead { font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .stats { display: none; }
    .stats-inline { display: block; }
    .sticky { padding: 8px 0; }
    .toolbar { flex-wrap: nowrap; gap: 8px; }
    .segmented { flex: none; }
    .seg { padding: 8px 10px; }
    .seg-l { display: none; }
    .seg-i { display: block; }
    .search { min-width: 0; height: 40px; }
    .sticky .jump { display: none; }
    .jump.below { display: flex; }
    .group { scroll-margin-top: 130px; }
    .seg { padding: 9px 14px; }
    .jump .chip { min-height: 36px; padding-block: 6px; }
    .jump { mask-image: linear-gradient(90deg, #000 85%, transparent); padding-right: 24px; }
  }
</style>
