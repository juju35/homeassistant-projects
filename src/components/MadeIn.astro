---
// Made in France, and built with Claude
import Icon from "./Icon.astro";
import fr from "flag-icons/flags/4x3/fr.svg";
import { OWNER } from "../lib/projects";
---

<section class="made" id="about" aria-labelledby="about-title">
  <h2 class="section-title" id="about-title"><Icon name="mdiHeart" />Behind the projects</h2>
  <div class="made-grid">
    <div class="ha-card france">
      <span class="ribbon" aria-hidden="true"></span>
      <div class="header">
        <span class="flag"><img src={fr.src} alt="" width="56" height="42" loading="lazy" decoding="async" /></span>
        <div class="titles">
          <div class="kicker">Cocorico</div>
          <h3>Made in France</h3>
        </div>
      </div>
      <p class="muted">
        Designed, coded and tested in France by <a href={`https://github.com/${OWNER}`} target="_blank" rel="noopener">@{OWNER}</a>,
        and used every day on a real Home Assistant at home: a card ships once it has earned its place on the dashboard.
      </p>
      <ul class="facts">
        <li class="chip neutral"><Icon name="mdiMapMarkerOutline" />France</li>
        <li class="chip neutral"><Icon name="mdiHomeAssistant" />Home Assistant</li>
        <li class="chip neutral"><Icon name="mdiCheckDecagram" />Open source</li>
      </ul>
    </div>

    <div class="ha-card claude">
      <span class="glow" aria-hidden="true"></span>
      <div class="header">
        <span class="logo lg"><Icon name="mdiCreation" /></span>
        <div class="titles">
          <div class="kicker">Built with</div>
          <h3>Claude</h3>
        </div>
      </div>
      <p class="muted">
        Written in tandem with Claude, Anthropic's AI, through Claude Code: code, tests, screenshots, documentation and
        the 22 translations. Every change goes through a pull request, the CI and a human review before it is merged.
      </p>
      <ul class="facts">
        <li class="chip"><Icon name="mdiSourcePull" />Pull requests</li>
        <li class="chip"><Icon name="mdiTranslate" />Translations</li>
      </ul>
      <a class="btn ghost more" href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code <Icon name="mdiOpenInNew" /></a>
    </div>
  </div>
</section>

<style>
  .made { margin-top: 40px; scroll-margin-top: 130px; }
  .made-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .made-grid .ha-card { position: relative; overflow: hidden; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .made-grid p { margin: 0; font-size: 14px; line-height: 1.55; }
  .made-grid p a { color: var(--primary-text-color); font-weight: 500; }
  .made-grid p a:hover { text-decoration: underline; }
  .header { align-items: center; }
  h3 { margin: 0; font-size: 22px; font-weight: 500; line-height: 1.15; }
  .kicker { font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--secondary-text-color); }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .france .facts { margin-top: auto; }

  /* France: a tricolour ribbon along the top and a waving flag */
  .ribbon {
    position: absolute; inset: 0 0 auto; height: 5px;
    background: linear-gradient(90deg, #002395 0 33.33%, #fff 33.33% 66.66%, #ed2939 66.66%);
  }
  .france::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, #002395 9%, transparent), transparent 60%),
      radial-gradient(120% 70% at 100% 0%, color-mix(in srgb, #ed2939 9%, transparent), transparent 60%);
  }
  .france > * { position: relative; }
  .france .ribbon { position: absolute; }
  .flag {
    position: relative; flex: none; width: 56px; height: 42px; border-radius: 8px; overflow: hidden;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary-text-color) 12%, transparent), 0 3px 10px rgb(0 0 0 / .18);
    transform-origin: left center; animation: wave 3.2s ease-in-out infinite;
  }
  .flag img { width: 100%; height: 100%; object-fit: cover; }
  .flag::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(105deg, rgb(255 255 255 / .3), transparent 40%, rgb(0 0 0 / .1) 70%, rgb(255 255 255 / .15));
  }
  @keyframes wave {
    0%, 100% { transform: perspective(160px) rotateY(0) skewY(0); }
    35% { transform: perspective(160px) rotateY(-12deg) skewY(-2deg); }
    70% { transform: perspective(160px) rotateY(7deg) skewY(1.5deg); }
  }

  /* Claude: warm clay accent */
  .claude { --c: #d97757; }
  .glow {
    position: absolute; width: 260px; height: 260px; right: -90px; top: -110px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, #d97757 22%, transparent), transparent 70%);
  }
  .claude > *:not(.glow) { position: relative; }
  .claude .logo svg { animation: twinkle 2.8s ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(1.12) rotate(8deg); } }
  .more { align-self: flex-start; }
  .more svg { width: 16px; height: 16px; }

  @media (prefers-reduced-motion: reduce) {
    .flag, .claude .logo svg { animation: none; }
  }
  @media (max-width: 760px) {
    .made-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .made-grid .ha-card { padding: 16px; }
  }
</style>
