---
// Screenshots and animations of a project: one tab per card or variant, a grid of even tiles with a
// light / dark switch (when the project has both themes), and a viewer with previous / next, keyboard
// and swipe navigation, the same switch, a light / dark comparison and zoom. The tab and the capture
// shown are kept in the URL (#gallery/<group>/<n>), and Back closes the viewer.
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import { caption, shotUrl, type Project, type Shot as ShotT } from "../lib/projects";
import { imageSize } from "../lib/imgsize";
import { fullUrl, optimizedUrl } from "../lib/optimize";
import { withTwin } from "../lib/twins";

interface Props {
  project: Project;
}
const { project } = Astro.props;

type Item = { shot: ShotT; group: string; anim: boolean };
const stills: Item[] = await Promise.all(
  [project.hero, ...(project.screenshots ?? [])]
    .filter((s): s is ShotT => !!s)
    .map(async (s) => {
      const shot = await withTwin(project, s);
      return { shot, group: shot.group || "Screenshots", anim: false };
    }),
);
const anims: Item[] = await Promise.all(
  (project.animations ?? []).map(async (s) => ({ shot: await withTwin(project, s), group: "Animations", anim: true })),
);
const items = [...stills, ...anims];

const groups: { name: string; count: number; anim: boolean }[] = [];
for (const it of items) {
  const g = groups.find((x) => x.name === it.group);
  if (g) g.count++;
  else groups.push({ name: it.group, count: 1, anim: it.anim });
}

// Data for the viewer
const data = await Promise.all(
  items.map(async (it) => {
    const lightRaw = shotUrl(project, it.shot.src);
    const darkRaw = it.shot.dark ? shotUrl(project, it.shot.dark) : null;
    const size = await imageSize(lightRaw);
    return {
      group: it.group,
      caption: caption(it.shot),
      // Viewer: optimised at full resolution; strip: light thumbnails (2x of their 76px); link: the original
      light: await fullUrl(lightRaw),
      dark: darkRaw ? await fullUrl(darkRaw) : null,
      lightThumb: await optimizedUrl(lightRaw, 160),
      darkThumb: darkRaw ? await optimizedUrl(darkRaw, 160) : null,
      lightOrig: lightRaw,
      darkOrig: darkRaw,
      w: size?.w ?? null,
      h: size?.h ?? null,
      anim: it.anim,
    };
  }),
);
const slugId = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const hasDark = data.some((d) => d.dark);
---

{
  !(items.length === 1 && project.hero) && items.length > 0 && (
    <section class="ha-card gallery" id="gallery" data-gallery={JSON.stringify(data)}>
      <div class="g-head">
        <h2 class="section-title">
          <Icon name="mdiImageMultiple" /> Gallery <span class="chip neutral count">{items.length}</span>
        </h2>
        {groups.length > 1 && (
          <div class="tabs" role="tablist" aria-label="Screenshot groups">
            {groups.map((g, i) => (
              <button
                class:list={["tab", { active: i === 0 }]}
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls="gallery-panel"
                tabindex={i === 0 ? 0 : -1}
                data-tab={g.name}
                id={`tab-${slugId(g.name)}`}
              >
                {g.anim && <Icon name="mdiPlayCircleOutline" />}
                {g.name}
                <span class="n">{g.count}</span>
              </button>
            ))}
          </div>
        )}
        {hasDark && (
          <div class="themes" role="group" aria-label="Theme of the screenshots">
            <button type="button" data-shots="light" aria-pressed="false"><Icon name="mdiWhiteBalanceSunny" /> Light</button>
            <button type="button" data-shots="dark" aria-pressed="false"><Icon name="mdiWeatherNight" /> Dark</button>
          </div>
        )}
      </div>

      <div
        class="tiles"
        id="gallery-panel"
        role={groups.length > 1 ? "tabpanel" : undefined}
        aria-labelledby={groups.length > 1 ? `tab-${slugId(groups[0].name)}` : undefined}
      >
        {items.map((it, i) => (
          <figure class="tile-fig" data-group={it.group} hidden={it.group !== groups[0].name}>
            <button class="tile-btn" type="button" data-index={i} aria-label={`Open: ${caption(it.shot)}`}>
              <Shot project={project} shot={it.shot} sizes="(max-width: 600px) 50vw, 300px" />
              {it.anim && (
                <span class="badge play" title="Animation">
                  <Icon name="mdiPlay" />
                </span>
              )}
              <span class="expand"><Icon name="mdiArrowExpand" /></span>
            </button>
            <figcaption>{caption(it.shot)}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<dialog class="viewer" aria-label="Screenshot viewer">
  <div class="v-bar">
    <div class="v-titles">
      <div class="v-caption"></div>
      <div class="v-sub"></div>
    </div>
    <div class="v-theme" role="group" aria-label="Theme of the screenshot">
      <button type="button" data-theme="light" title="Light theme (T)" aria-pressed="false"><Icon name="mdiWhiteBalanceSunny" /><span>Light</span></button>
      <button type="button" data-theme="dark" title="Dark theme (T)" aria-pressed="false"><Icon name="mdiWeatherNight" /><span>Dark</span></button>
    </div>
    <button class="v-cmp" type="button" aria-pressed="false" title="Compare light and dark (C)">
      <Icon name="mdiCompare" /><span>Compare</span>
    </button>
    <a class="icon-btn v-open" target="_blank" rel="noopener" aria-label="Open the original" title="Open the original"><Icon name="mdiOpenInNew" /></a>
    <button class="icon-btn v-close" type="button" aria-label="Close" title="Close (Esc)"><Icon name="mdiClose" /></button>
  </div>
  <div class="v-stage">
    <button class="v-zoom v-main" type="button"><img alt="" /></button>
    <div class="v-compare" hidden>
      <figure class="cmp cmp-light">
        <button class="v-zoom" type="button"><img alt="" /></button>
        <span class="cmp-tag"><Icon name="mdiWhiteBalanceSunny" /> Light</span>
      </figure>
      <figure class="cmp cmp-dark">
        <button class="v-zoom" type="button"><img alt="" /></button>
        <span class="cmp-tag"><Icon name="mdiWeatherNight" /> Dark</span>
      </figure>
    </div>
  </div>
  <div class="v-split">
    <Icon name="mdiWhiteBalanceSunny" />
    <input type="range" min="0" max="100" step="1" value="50" aria-label="Split between the light and dark captures" />
    <Icon name="mdiWeatherNight" />
  </div>
  <button class="v-nav prev" type="button" aria-label="Previous" title="Previous (←)"><Icon name="mdiChevronLeft" /></button>
  <button class="v-nav next" type="button" aria-label="Next" title="Next (→)"><Icon name="mdiChevronRight" /></button>
  <div class="v-strip" role="group" aria-label="Captures"></div>
</dialog>

<script>
  type Item = {
    group: string; caption: string; light: string; dark: string | null;
    lightThumb: string; darkThumb: string | null; lightOrig: string; darkOrig: string | null;
    w: number | null; h: number | null; anim: boolean;
  };
  const section = document.querySelector<HTMLElement>("[data-gallery]");
  const dialog = document.querySelector<HTMLDialogElement>("dialog.viewer");
  if (section && dialog) {
    const items: Item[] = JSON.parse(section.dataset.gallery!);
    const tabs = [...section.querySelectorAll<HTMLButtonElement>(".tab")];
    const panel = section.querySelector<HTMLElement>(".tiles")!;
    const figs = [...section.querySelectorAll<HTMLElement>(".tile-fig")];
    const $ = <T extends Element = HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
    const mainBtn = $<HTMLButtonElement>(".v-main");
    const img = mainBtn.querySelector("img")!;
    const stage = $(".v-stage");
    const strip = $(".v-strip");
    const capEl = $(".v-caption");
    const subEl = $(".v-sub");
    const themeBox = $(".v-theme");
    const themeBtns = [...themeBox.querySelectorAll<HTMLButtonElement>("button")];
    const cmpBtn = $<HTMLButtonElement>(".v-cmp");
    const cmpBox = $(".v-compare");
    const cmpLight = cmpBox.querySelector<HTMLImageElement>(".cmp-light img")!;
    const cmpDark = cmpBox.querySelector<HTMLImageElement>(".cmp-dark img")!;
    const split = $<HTMLInputElement>(".v-split input");
    const closeBtn = $<HTMLButtonElement>(".v-close");
    const openLink = $<HTMLAnchorElement>(".v-open");
    const zoomBtns = [...dialog.querySelectorAll<HTMLButtonElement>(".v-zoom")];
    const wideMq = matchMedia("(min-width: 721px)");
    const siteDark = () => {
      const t = document.documentElement.dataset.theme;
      return t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    };

    let group = tabs[0]?.dataset.tab ?? items[0]?.group;
    let list: number[] = [];
    let pos = 0;
    let comparing = false;
    let zoomed = false;
    // Theme of the screenshots: the site's until one is picked in the gallery or the viewer.
    let chosen: boolean | null = null;
    const shotsDark = () => chosen ?? siteDark();
    let dark = shotsDark();
    const themeButtons = [...section.querySelectorAll<HTMLButtonElement>(".themes button")];
    const showTheme = () => {
      const d = shotsDark();
      if (chosen === null) delete section.dataset.shots;
      else section.dataset.shots = d ? "dark" : "light";
      for (const b of themeButtons) {
        const on = (b.dataset.shots === "dark") === d;
        b.classList.toggle("on", on);
        b.setAttribute("aria-pressed", String(on));
      }
    };
    const pickTheme = (d: boolean) => {
      chosen = d;
      showTheme();
    };
    themeButtons.forEach((b) => b.addEventListener("click", () => pickTheme(b.dataset.shots === "dark")));
    // Following the site theme while none is picked (the header switch, or the system theme).
    new MutationObserver(showTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", showTheme);
    showTheme();

    // URL: #gallery/<group>, and #gallery/<group>/<n> while the viewer shows the n-th capture of the group.
    const slugId = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
    const groupNames = [...new Set(items.map((it) => it.group))];
    const tabHash = (g: string) => `#gallery/${slugId(g)}`;
    const viewerHash = () => `${tabHash(items[list[pos]].group)}/${pos + 1}`;
    const inGroup = (g: string) => items.map((_, i) => i).filter((i) => items[i].group === g);
    const parseHash = () => {
      const m = /^#gallery\/([^/]+)(?:\/(\d+))?\/?$/.exec(location.hash);
      const g = m && groupNames.find((n) => slugId(n) === decodeURIComponent(m[1]));
      if (!g) return null;
      const idx = inGroup(g);
      const n = m[2] ? Number(m[2]) : 0;
      return { group: g, index: n >= 1 && n <= idx.length ? idx[n - 1] : null };
    };
    const setHash = (hash: string, mode: "push" | "replace", state: object | null = null) => {
      if (location.hash === hash && mode === "replace" && history.state === state) return;
      history[mode === "push" ? "pushState" : "replaceState"](state, "", hash);
    };

    // Tabs: a tablist with a roving tabindex
    const selectTab = (name: string) => {
      group = name;
      for (const t of tabs) {
        const on = t.dataset.tab === name;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on) panel.setAttribute("aria-labelledby", t.id);
      }
      for (const f of figs) f.hidden = f.dataset.group !== name;
    };
    const userSelectTab = (t: HTMLButtonElement) => {
      selectTab(t.dataset.tab!);
      setHash(tabHash(t.dataset.tab!), "replace");
    };
    tabs.forEach((t) => t.addEventListener("click", () => userSelectTab(t)));
    section.querySelector(".tabs")?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const j = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i - 1 + tabs.length) % tabs.length, Home: 0, End: tabs.length - 1 }[ev.key];
      if (j === undefined) return;
      ev.preventDefault();
      tabs[j].focus();
      tabs[j].scrollIntoView({ block: "nearest", inline: "nearest" });
      userSelectTab(tabs[j]);
    });

    // Sizes: fitted to the stage, or at the size the capture was taken for (zoom)
    const natural = (it: Item) => {
      if (it.w && it.h) return it.anim ? { w: it.w, h: it.h } : { w: it.w / 2, h: it.h / 2 };
      return img.naturalWidth ? { w: img.naturalWidth, h: img.naturalHeight } : null;
    };
    const layout = () => {
      if (!dialog.open || !list.length) return;
      const it = items[list[pos]];
      const nat = natural(it);
      const shown = comparing && !!it.dark;
      const imgs = shown ? [cmpLight, cmpDark] : [img];
      if (!nat) {
        imgs.forEach((i) => (i.style.width = ""));
        zoomBtns.forEach((b) => (b.disabled = true));
        return;
      }
      const cs = getComputedStyle(stage);
      let w = stage.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      if (shown) {
        const fs = getComputedStyle(cmpBox.firstElementChild!);
        if (wideMq.matches) w = (w - parseFloat(getComputedStyle(cmpBox).columnGap || "0")) / 2;
        w -= parseFloat(fs.paddingLeft) + parseFloat(fs.paddingRight);
      }
      // Default: the capture at its own display size, never wider than the stage (tall ones scroll).
      const fit = Math.max(40, Math.floor(Math.min(nat.w, w)));
      // Zoom: its full pixel resolution, when that is larger.
      const full = it.w ?? nat.w;
      const zoomTo = full > fit + 1 ? full : null;
      if (!zoomTo) zoomed = false;
      const width = zoomed && zoomTo ? zoomTo : fit;
      imgs.forEach((i) => (i.style.width = `${Math.round(width)}px`));
      stage.classList.toggle("zoomed", zoomed);
      for (const b of zoomBtns) {
        b.disabled = !zoomTo;
        b.classList.toggle("out", zoomed);
        b.setAttribute("aria-label", zoomTo ? (zoomed ? "Fit to the screen" : "Zoom to full size") : it.caption);
      }
    };
    const toggleZoom = (e: MouseEvent) => {
      const btn = e.currentTarget as HTMLElement;
      // Keep the point under the pointer (or the centre) in place
      const r = btn.getBoundingClientRect();
      const fx = e.detail ? (e.clientX - r.left) / r.width : 0.5;
      const fy = e.detail ? (e.clientY - r.top) / r.height : 0.5;
      zoomed = !zoomed;
      layout();
      const r2 = btn.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      stage.scrollLeft += r2.left + fx * r2.width - (e.detail ? e.clientX : s.left + s.width / 2);
      stage.scrollTop += r2.top + fy * r2.height - (e.detail ? e.clientY : s.top + s.height / 2);
    };
    zoomBtns.forEach((b) => b.addEventListener("click", toggleZoom));
    // Only width matters to the layout (the height follows the content)
    let stageW = 0;
    new ResizeObserver(() => {
      if (stage.clientWidth === stageW) return;
      stageW = stage.clientWidth;
      layout();
    }).observe(stage);
    [img, cmpLight, cmpDark].forEach((i) => i.addEventListener("load", () => layout()));

    // Viewer
    const render = () => {
      const it = items[list[pos]];
      const useDark = dark && !!it.dark;
      const shown = comparing && !!it.dark;
      const want = useDark ? it.dark! : it.light;
      if (img.getAttribute("src") !== want) img.src = want;
      img.alt = it.caption;
      // The focused capture hands its focus over when compare shows or hides it
      const fromMain = shown && document.activeElement === mainBtn;
      const fromCmp = !shown && cmpBox.contains(document.activeElement);
      cmpBox.hidden = !shown;
      mainBtn.hidden = shown;
      dialog.classList.toggle("comparing", shown);
      if (shown) {
        if (cmpLight.getAttribute("src") !== it.light) cmpLight.src = it.light;
        if (cmpDark.getAttribute("src") !== it.dark) cmpDark.src = it.dark!;
        cmpLight.alt = `${it.caption} (light)`;
        cmpDark.alt = `${it.caption} (dark)`;
      }
      stage.classList.toggle("is-dark", !shown && (useDark || (!it.dark && siteDark())));
      capEl.textContent = it.caption;
      subEl.textContent = it.caption === it.group ? `${pos + 1} / ${list.length}` : `${it.group} · ${pos + 1} / ${list.length}`;
      // Controls about to disappear hand the focus to the Close button
      const leaving = (!it.dark && (themeBox.contains(document.activeElement) || document.activeElement === cmpBtn)) ||
        (shown && themeBox.contains(document.activeElement));
      if (leaving) closeBtn.focus();
      themeBox.hidden = !it.dark || shown;
      cmpBtn.hidden = !it.dark;
      cmpBtn.setAttribute("aria-pressed", String(shown));
      cmpBtn.classList.toggle("on", shown);
      for (const b of themeBtns) {
        const on = (b.dataset.theme === "dark") === useDark;
        b.classList.toggle("on", on);
        b.setAttribute("aria-pressed", String(on));
      }
      openLink.href = useDark ? it.darkOrig! : it.lightOrig;
      strip.querySelectorAll<HTMLElement>(".s").forEach((s, i) => {
        const t = items[list[i]];
        const thumb = s.querySelector("img")!;
        const w = dark && t.darkThumb ? t.darkThumb : t.lightThumb;
        if (thumb.getAttribute("src") !== w) thumb.src = w;
        s.classList.toggle("on", i === pos);
        if (i === pos) {
          s.setAttribute("aria-current", "true");
          s.scrollIntoView({ block: "nearest", inline: "center" });
        } else s.removeAttribute("aria-current");
      });
      dialog.classList.toggle("single", list.length < 2);
      layout();
      const target = fromMain ? cmpBox.querySelector<HTMLButtonElement>(".v-zoom")! : fromCmp ? mainBtn : null;
      if (target) (target.disabled ? closeBtn : target).focus();
      // Warm the neighbours
      for (const d of [-1, 1]) {
        const n = items[list[(pos + d + list.length) % list.length]];
        if (n) new Image().src = dark && n.dark ? n.dark : n.light;
      }
    };
    const goTo = (k: number) => {
      pos = k;
      zoomed = false;
      stage.scrollTop = 0;
      stage.scrollLeft = 0;
      render();
      if (dialog.open) setHash(viewerHash(), "replace", history.state);
    };
    // history: "push" adds an entry (Back closes the viewer), "none" when the URL is already the viewer's.
    const open = (index: number, history_: "push" | "none" = "push") => {
      const g = items[index].group;
      list = inGroup(g);
      pos = list.indexOf(index);
      zoomed = false;
      dark = shotsDark();
      strip.innerHTML = "";
      list.forEach((i, k) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "s";
        b.setAttribute("aria-label", items[i].caption);
        const t = document.createElement("img");
        t.src = dark && items[i].darkThumb ? items[i].darkThumb! : items[i].lightThumb;
        t.alt = "";
        t.loading = "lazy";
        b.append(t);
        b.addEventListener("click", () => goTo(k));
        strip.append(b);
      });
      const wasOpen = dialog.open;
      if (!wasOpen) dialog.showModal();
      stage.scrollTop = 0;
      stage.scrollLeft = 0;
      render();
      if (!wasOpen) closeBtn.focus();
      if (history_ === "push" && !wasOpen) setHash(viewerHash(), "push", { gallery: true });
      else if (history_ === "push") setHash(viewerHash(), "replace", history.state);
    };
    const step = (d: number) => {
      if (list.length < 2) return;
      goTo((pos + d + list.length) % list.length);
    };
    const setTheme = (d: boolean) => {
      dark = d;
      pickTheme(dark); // The tiles follow the viewer.
      render();
    };
    const toggleCompare = () => {
      if (!items[list[pos]]?.dark) return;
      comparing = !comparing;
      zoomed = false;
      render();
    };

    // Closing returns the focus to the tile of the capture last shown
    let closedByHistory = false;
    let focusAfterBack = false;
    const focusTile = () => {
      const it = items[list[pos]];
      if (!it) return;
      if (group !== it.group) selectTab(it.group);
      section.querySelector<HTMLElement>(`.tile-btn[data-index="${list[pos]}"]`)?.focus({ preventScroll: true });
      section.querySelector(`.tile-btn[data-index="${list[pos]}"]`)?.scrollIntoView({ block: "nearest" });
    };
    dialog.addEventListener("close", () => {
      [img, cmpLight, cmpDark].forEach((i) => i.removeAttribute("src"));
      comparing = false;
      dialog.classList.remove("comparing");
      const g = items[list[pos]]?.group ?? group;
      if (closedByHistory) {
        closedByHistory = false;
      } else if (history.state?.gallery) {
        // The entry the viewer added: going back to the one before keeps Back / Forward consistent.
        focusAfterBack = true;
        history.back();
        setTimeout(() => { if (focusAfterBack) { focusAfterBack = false; focusTile(); } }, 400);
        return;
      } else {
        setHash(tabHash(g), "replace");
      }
      focusTile();
    });
    addEventListener("popstate", () => {
      const h = parseHash();
      if (h && h.index !== null) {
        // Forward to a viewer entry
        selectTab(h.group);
        open(h.index, "none");
        return;
      }
      if (dialog.open) {
        closedByHistory = true;
        dialog.close();
      } else if (focusAfterBack) {
        focusAfterBack = false;
        requestAnimationFrame(focusTile);
      }
      if (h) selectTab(h.group);
    });

    section.querySelectorAll<HTMLButtonElement>(".tile-btn").forEach((b) =>
      b.addEventListener("click", () => open(Number(b.dataset.index))),
    );
    // The hero of the page opens the viewer on the first screenshot.
    document.querySelectorAll<HTMLElement>("[data-open-gallery]").forEach((el) =>
      el.addEventListener("click", () => { selectTab(items[0].group); open(0); }),
    );
    $(".prev").addEventListener("click", () => step(-1));
    $(".next").addEventListener("click", () => step(1));
    closeBtn.addEventListener("click", () => dialog.close());
    themeBtns.forEach((b) => b.addEventListener("click", () => setTheme(b.dataset.theme === "dark")));
    cmpBtn.addEventListener("click", toggleCompare);
    const setSplit = () => {
      cmpBox.style.setProperty("--split", `${split.value}%`);
      split.setAttribute("aria-valuetext", `${100 - Number(split.value)}% dark`);
    };
    split.addEventListener("input", setSplit);
    setSplit();
    wideMq.addEventListener("change", () => layout());
    // A click on the backdrop closes; clicks inside the viewer don't.
    dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (e.key === "Tab") {
        // Focus stays inside the viewer
        const f = [...dialog.querySelectorAll<HTMLElement>("button, a[href], input")].filter(
          (el) => !(el as HTMLButtonElement).disabled && el.getClientRects().length > 0 && getComputedStyle(el).visibility !== "hidden",
        );
        if (!f.length) return;
        const i = f.indexOf(document.activeElement as HTMLElement);
        const j = e.shiftKey ? (i <= 0 ? f.length - 1 : i - 1) : (i === -1 || i === f.length - 1 ? 0 : i + 1);
        if ((e.shiftKey && i <= 0) || (!e.shiftKey && (i === -1 || i === f.length - 1))) {
          e.preventDefault();
          f[j].focus();
        }
        return;
      }
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const onRange = t instanceof HTMLInputElement;
      if (e.key === "ArrowLeft" && !onRange) { e.preventDefault(); step(-1); }
      else if (e.key === "ArrowRight" && !onRange) { e.preventDefault(); step(1); }
      else if (e.key === "t" || e.key === "T") {
        if (items[list[pos]]?.dark && !comparing) { e.preventDefault(); setTheme(!dark); }
      } else if (e.key === "c" || e.key === "C") {
        if (items[list[pos]]?.dark) { e.preventDefault(); toggleCompare(); }
      }
    });
    // Swipe (not while zoomed: the stage pans)
    let x0: number | null = null;
    stage.addEventListener("touchstart", (e) => { x0 = zoomed || e.touches.length > 1 ? null : e.touches[0].clientX; }, { passive: true });
    stage.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      x0 = null;
    });

    // Opening the page on #gallery/<group>[/<n>]
    const h0 = parseHash();
    if (h0) {
      selectTab(h0.group);
      const scroll = () => section.scrollIntoView({ block: "start" });
      scroll();
      requestAnimationFrame(scroll);
      if (h0.index !== null) {
        // The tab's entry under the viewer's: Back closes the viewer and stays on the page.
        setHash(tabHash(h0.group), "replace");
        open(h0.index);
      }
    }
  }
</script>

