---
// The round slot the site uses for icons: the site's icon in the project's accent (the cards' header pastille), or,
// with `own` on an integration's page, the integration's own icon (the one at the top of its README) when it has one.
import Icon from "./Icon.astro";
import type { Project } from "../lib/projects";
import { getLogos } from "../lib/logos";

interface Props {
  project: Project;
  /** Size variant of .logo: sm, lg or xl. */
  size?: "sm" | "lg" | "xl";
  /** Accent set on the slot (when the parent doesn't set --c). */
  accent?: boolean;
  /** Show an integration's own icon (its page); the cards and the tiles keep the site's icon. */
  own?: boolean;
}
const { project, size, accent = false, own: useOwn = false } = Astro.props;
const own = useOwn && project.kind === "integration" ? (await getLogos(project)).own : null;
---

{
  own ? (
    <span class:list={["logo", size, "has-img"]}>
      <img src={own.src} alt="" loading="lazy" decoding="async" />
    </span>
  ) : (
    <span class:list={["logo", size]} style={accent ? `--c:${project.accent}` : undefined}>
      <Icon name={project.icon} />
    </span>
  )
}
