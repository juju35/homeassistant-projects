---
import Icon from "./Icon.astro";
import { getDocs } from "../lib/docs";
import { repoUrl, type Project } from "../lib/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const sections = await getDocs(project);

const iconFor = (t: string) => {
  const s = t.toLowerCase();
  if (s.startsWith("feature")) return "mdiStarFourPointsOutline";
  if (s.startsWith("prerequisite")) return "mdiClipboardCheckOutline";
  if (s.startsWith("configuration") || s.includes("option")) return "mdiTuneVariant";
  if (s.startsWith("entit")) return "mdiShape";
  if (s.startsWith("action") || s.startsWith("service")) return "mdiPlayCircleOutline";
  if (s.startsWith("event")) return "mdiLightningBolt";
  if (s.startsWith("how it works")) return "mdiCogOutline";
  if (s.startsWith("supported")) return "mdiCheckDecagramOutline";
  if (s.includes("card")) return "mdiCardsOutline";
  return "mdiTextBoxOutline";
};
---

<section class="docs" id="documentation">
  <p class="sr-only" id="docs-live" aria-live="polite"></p>
  <div class="docs-head">
    <h2 class="section-title"><Icon name="mdiBookOpenPageVariantOutline" /> Documentation</h2>
    <a class="src muted" href={`${repoUrl(project)}#readme`} target="_blank" rel="noopener">
      From the README <Icon name="mdiOpenInNew" />
    </a>
  </div>

  {
    sections && sections.length ? (
      <>
        <nav class="toc" aria-label="Documentation sections">
          {sections.map((s) => (
            <a class="chip neutral" href={`#${s.id}`} data-open={s.id}>
              <Icon name={iconFor(s.title)} />
              {s.title}
            </a>
          ))}
        </nav>
        {sections.map((s) => (
          <details class="fold ha-card doc" id={s.id} open={s.open}>
            <summary>
              <h3 class="section-title">
                <Icon name={iconFor(s.title)} /> {s.title}
                <Icon name="mdiChevronRight" class="chev" />
              </h3>
            </summary>
            <div class="md" set:html={s.html} />
          </details>
        ))}
      </>
    ) : (
      <p class="ha-card pad muted">
        The documentation could not be loaded. Read it on <a href={`${repoUrl(project)}#readme`}>GitHub</a>.
      </p>
    )
  }
</section>

<script is:inline>
  (() => {
    // A table-of-contents chip, a #link inside the docs, or a #doc-… deep link unfolds its section first.
    const target = (hash) => {
      if (!hash || hash.length < 2) return null;
      let id = hash.slice(1);
      try { id = decodeURIComponent(id); } catch {}
      return document.getElementById(id);
    };
    const openFor = (hash, scroll) => {
      const el = target(hash);
      const fold = el && el.closest("details.doc");
      if (!fold) return;
      fold.open = true;
      if (!scroll) return;
      // The README's own h2 is hidden (the fold shows it): scroll to the fold instead.
      const to = el.offsetParent === null ? fold : el;
      requestAnimationFrame(() => to.scrollIntoView({ block: "start" }));
    };
    document.addEventListener("click", (e) => {
      const a = e.target.closest && e.target.closest('a[href^="#"]');
      if (!a) return;
      const href = a.getAttribute("href");
      const el = target(href);
      if (el && el.offsetParent === null && el.closest("details.doc")) {
        // Hidden target (closed fold or hidden h2): unfold and scroll ourselves.
        e.preventDefault();
        history.pushState(null, "", href);
        openFor(href, true);
      } else openFor(href, false);
    });
    addEventListener("hashchange", () => openFor(location.hash, true));
    openFor(location.hash, true);

    // Open sections keep their title stuck just under the section bar (its height changes on phones).
    const subnav = document.querySelector(".subnav");
    if (subnav) {
      const set = () =>
        document.documentElement.style.setProperty(
          "--subnav-bottom",
          `${(parseFloat(getComputedStyle(subnav).top) || 0) + subnav.offsetHeight}px`,
        );
      new ResizeObserver(set).observe(subnav);
      addEventListener("resize", set);
      set();
    }
    // Folding a long section from its stuck title: bring its title back into view instead of landing further down.
    document.addEventListener(
      "toggle",
      (e) => {
        const fold = e.target;
        if (!fold.matches || !fold.matches("details.doc") || fold.open) return;
        if (fold.getBoundingClientRect().top < 0) fold.scrollIntoView({ block: "start" });
      },
      true,
    );

    // Copy buttons of the code blocks.
    const live = document.getElementById("docs-live");
    document.addEventListener("click", async (e) => {
      const btn = e.target.closest && e.target.closest("button.doc-copy");
      if (!btn) return;
      const pre = btn.parentElement.querySelector("pre");
      try {
        await navigator.clipboard.writeText((pre ? pre.innerText : "").replace(/\n$/, ""));
        btn.classList.add("done");
        clearTimeout(btn._t);
        btn._t = setTimeout(() => btn.classList.remove("done"), 1500);
        if (live) {
          live.textContent = "";
          setTimeout(() => (live.textContent = "Copied"), 50);
        }
      } catch {}
    });
  })();
</script>

<style>
  .docs { margin-top: 8px; scroll-margin-top: 130px; display: flex; flex-direction: column; gap: 12px; }
  .docs-head { display: flex; align-items: center; gap: 12px; }
  .docs-head .section-title { margin: 0; }
  .src { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; font-size: 13px; }
  .src:hover { color: var(--primary-text-color); }
  .src :global(svg) { width: 14px; height: 14px; }
  .toc { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
  .toc .chip { padding: 4px 12px; font-size: 13px; }
  .toc .chip:hover { background: color-mix(in srgb, var(--secondary-text-color) 22%, transparent); }
  .pad { padding: 16px 20px; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .doc { padding: 0 20px; scroll-margin-top: 130px; }
  .doc > summary { padding: 16px 0; }
  .doc > summary .section-title { margin: 0; color: var(--primary-text-color); }
  .doc > summary .section-title :global(svg:first-child) { color: var(--c); }
  .doc[open] > summary { border-bottom: 1px solid var(--divider-color); margin-bottom: 4px; }
  /* An open section keeps its title under the section bar while it is read: one tap folds it back */
  .doc[open] > summary {
    position: sticky; top: var(--subnav-bottom, 120px); z-index: 2;
    margin-inline: -20px; padding-inline: 20px;
    background: var(--card-background-color);
  }
  /* Prose at a readable line length; tables and code keep the full width */
  .md > :global(p), .md > :global(ul), .md > :global(ol), .md > :global(blockquote), .md > :global(h3), .md > :global(h4) { max-width: 82ch; }
  /* A My Home Assistant badge inside a sentence stays close to the line height */
  .md :global(li a.ha-badge img) { height: 30px; width: auto; }
  .md { padding-bottom: 16px; }

  /* README content, in the cards' style */
  .md :global(.doc-anchor) { display: none; }
  .md :global(h3) { font-size: 16px; font-weight: 500; margin: 24px 0 8px; scroll-margin-top: 130px; }
  .md :global(h4) { font-size: 14px; font-weight: 500; margin: 20px 0 6px; color: var(--secondary-text-color); text-transform: uppercase; letter-spacing: .05em; }
  .md :global([id]) { scroll-margin-top: 130px; }

  /* Heading permalinks: a small "#" shown on hover or focus */
  .md :global(a.hl) {
    margin-left: 6px; padding: 0 4px; border-radius: 4px;
    font-weight: 400; color: var(--secondary-text-color); text-decoration: none;
    opacity: 0; transition: opacity .15s, color .15s;
  }
  .md :global(h3:hover a.hl), .md :global(h4:hover a.hl), .md :global(a.hl:focus-visible) { opacity: 1; }
  .md :global(a.hl:hover) { color: color-mix(in srgb, var(--c), var(--ink) var(--ink-amt)); text-decoration: none; }
  .md :global(a.hl:focus-visible) { outline: 2px solid var(--primary-color); outline-offset: 1px; }
  @media (hover: none) { .md :global(a.hl) { opacity: .5; } }
  .md :global(p), .md :global(li) { font-size: 14px; line-height: 1.6; }
  .md :global(p) { margin: 10px 0; }
  .md :global(ul), .md :global(ol) { padding-left: 20px; margin: 10px 0; }
  .md :global(li) { margin: 4px 0; }
  .md :global(li::marker) { color: var(--c); }
  .md :global(a) { color: var(--c); font-weight: 500; }
  .md :global(a:hover) { text-decoration: underline; }
  .md :global(strong) { font-weight: 500; }
  .md :global(:not(pre) > code) {
    font-size: 12.5px; padding: 1px 6px; border-radius: 6px;
    background: var(--secondary-background-color); white-space: nowrap;
  }
  .md :global(.code-block) { position: relative; margin: 12px 0; }
  .md :global(.code-block > pre) { margin: 0; padding-right: 48px; }
  .md :global(.doc-copy) { position: absolute; top: 4px; right: 4px; }
  .md :global(.doc-copy .i-done) { display: none; }
  .md :global(.doc-copy.done) { color: var(--success-color); }
  .md :global(.doc-copy.done .i-copy) { display: none; }
  .md :global(.doc-copy.done .i-done) { display: block; }
  .md :global(pre) {
    margin: 12px 0; padding: 12px 14px; overflow-x: auto;
    background: var(--secondary-background-color); border-radius: var(--radius);
    font-size: 13px; line-height: 1.5;
  }
  .md :global(blockquote) {
    margin: 12px 0; padding: 8px 14px; border-radius: var(--radius);
    background: color-mix(in srgb, var(--c) 10%, transparent);
    border-left: 3px solid var(--c);
  }
  .md :global(blockquote p) { margin: 4px 0; }

  /* GitHub alerts (> [!NOTE] …) */
  .md :global(blockquote.alert) {
    --a: var(--c);
    background: color-mix(in srgb, var(--a) 10%, transparent);
    border-left-color: var(--a);
  }
  .md :global(blockquote.alert-important) { --a: #8e24aa; }
  .md :global(blockquote.alert-warning) { --a: var(--warning-color); }
  .md :global(blockquote.alert-caution) { --a: #db4437; }
  .md :global(.alert-title) {
    display: flex; align-items: center; gap: 6px; margin: 2px 0 4px;
    font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: .05em;
    color: color-mix(in srgb, var(--a) 60%, var(--primary-text-color));
  }
  .md :global(.alert-title::before) {
    content: "i"; display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%;
    font-size: 11px; font-weight: 700; text-transform: none; letter-spacing: 0;
    color: var(--card-background-color, #fff); background: color-mix(in srgb, var(--a) 60%, var(--primary-text-color));
  }
  .md :global(.alert-tip .alert-title::before) { content: "\2713"; }
  .md :global(.alert-important .alert-title::before),
  .md :global(.alert-warning .alert-title::before),
  .md :global(.alert-caution .alert-title::before) { content: "!"; }
  .md :global(blockquote.alert a) { color: var(--primary-text-color); text-decoration: underline; }

  /* my.home-assistant.io badges, as in the READMEs: 40px high like the page's buttons */
  .md :global(a.ha-badge) { display: inline-flex; vertical-align: middle; border-radius: 20px; transition: filter .2s ease; }
  .md :global(a.ha-badge:hover) { filter: brightness(1.06); }
  /* Width from the width/height attributes (the SVGs declare none of their own) */
  .md :global(a.ha-badge img) { max-width: 100%; height: auto; border-radius: 20px; }
  .md :global(img) { display: inline-block; max-width: 100%; height: auto; border-radius: 8px; }
  .md :global(hr) { border: 0; border-top: 1px solid var(--divider-color); margin: 20px 0; }

  /* Option tables: a tile header, thin dividers, scroll on narrow screens */
  .md :global(table) {
    display: block; width: 100%; overflow-x: auto;
    border-collapse: separate; border-spacing: 0;
    margin: 12px 0; font-size: 13.5px;
  }
  .md :global(thead th) {
    text-align: left; font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: .04em;
    color: var(--secondary-text-color); background: var(--secondary-background-color);
    padding: 8px 12px; white-space: nowrap;
  }
  .md :global(thead th:first-child) { border-radius: 8px 0 0 8px; }
  .md :global(thead th:last-child) { border-radius: 0 8px 8px 0; }
  .md :global(td) { padding: 8px 12px; border-bottom: 1px solid var(--divider-color); vertical-align: top; }
  .md :global(tbody tr:last-child td) { border-bottom: 0; }
  .md :global(td:first-child code) { color: color-mix(in srgb, var(--c), var(--ink) var(--ink-amt)); background: color-mix(in srgb, var(--c) 12%, transparent); white-space: nowrap; }
  .md :global(td) { min-width: 9ch; }
  .md :global(td:last-child) { min-width: 22ch; }

  @media (max-width: 600px) {
    .doc { padding: 0 14px; }
    .doc[open] > summary { margin-inline: -14px; padding-inline: 14px; }
    .md :global(:not(pre) > code) { white-space: normal; overflow-wrap: anywhere; }
    .md :global(td:first-child code) { white-space: nowrap; }
    .md :global(table) { mask-image: linear-gradient(90deg, #000 88%, transparent); }
  }

  /* Phones: each row of a table becomes a small card, each cell labelled with its column */
  @media (max-width: 640px) {
    .md :global(table.stack) { display: block; overflow: visible; mask-image: none; font-size: 14px; }
    .md :global(table.stack thead) { display: none; }
    .md :global(table.stack tbody), .md :global(table.stack tr) { display: block; }
    .md :global(table.stack tr) {
      margin: 8px 0; padding: 10px 14px;
      border: 1px solid var(--divider-color); border-radius: var(--radius);
    }
    .md :global(table.stack td) {
      display: block; min-width: 0; padding: 3px 0; border: 0;
      overflow-wrap: anywhere;
    }
    .md :global(table.stack td:empty) { display: none; }
    /* Label in a hanging column on the left, the value wraps beside it */
    .md :global(table.stack td + td) { padding-left: 100px; }
    .md :global(table.stack td + td::before) {
      content: attr(data-label); float: left; width: 90px; margin-left: -100px;
      font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .05em;
      color: var(--secondary-text-color); overflow-wrap: normal;
    }
    .md :global(table.stack td:first-child) {
      padding: 0 0 4px; font-size: 15px; font-weight: 500;
      color: color-mix(in srgb, var(--c), var(--ink) var(--ink-amt));
    }
    .md :global(table.stack td:first-child code) { font-size: 13.5px; white-space: normal; overflow-wrap: anywhere; }
  }
</style>
