---
import Icon from "./Icon.astro";
import ProjectLogo from "./ProjectLogo.astro";
import Shot from "./Shot.astro";
import MarketplaceBadge from "./MarketplaceBadge.astro";
import { kindClass, kindLabel, projects, type Project } from "../lib/projects";
import { formatDate, latestRelease } from "../lib/releases";
import { compact, newSlugs, repoInfo } from "../lib/repo";
import { getDocs } from "../lib/docs";
import { getLogos } from "../lib/logos";

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL;
// Words the home search matches every word of the query against: name, description, highlights, card types, the
// brands of its README header and the headings of its documentation. Lower-case, accent-free, each word once.
const docs = (await getDocs(p)) ?? [];
const headings = docs.flatMap((d) => [d.title, ...[...d.html.matchAll(/<h[34][^>]*>([\s\S]*?)<\/h[34]>/g)].map((m) => m[1])]);
const brandNames = (await getLogos(p)).brands.map((b) => b.alt);
const search = [
  ...new Set(
    [p.title, p.slug, p.tagline, p.summary, p.keywords ?? "", ...p.highlights, ...(p.cardTypes ?? []), ...brandNames, ...headings]
      .join(" ")
      .replace(/<[^>]+>|&[a-z#0-9]+;/gi, " ")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .split(/[^a-z0-9._+-]+/)
      // "weather-plus-card" is found as a whole and by each of its parts
      .flatMap((w) => (w.includes("-") ? [w, ...w.split("-")] : [w]))
      .filter((w) => w.length > 1),
  ),
].join(" ");
// Projects it works with, declared on either side
const related = projects.filter(
  (o) => o.slug !== p.slug && (p.worksWith?.some((w) => w.slug === o.slug) || o.worksWith?.some((w) => w.slug === p.slug)),
);
const shots = (p.screenshots?.length ?? 0) + (p.hero ? 1 : 0);
const anims = p.animations?.length ?? 0;
const release = await latestRelease(p);
const fresh = (await newSlugs()).has(p.slug);
const repo = await repoInfo(p);
// "Nov 22" this year, "Nov 22, 2025" before
const short = (iso: string) => {
  const d = formatDate(iso);
  return iso.slice(0, 4) === String(new Date().getUTCFullYear()) ? d.replace(/, \d{4}$/, "") : d;
};
---

<!-- A calm tile of its category card: the whole tile opens the project (its title link covers it), the Add to
     Marketplace badge sits on top -->
<article
  class:list={["project", { archived: p.archived, wip: p.wip }]}
  style={`--c:${p.accent}`}
  data-kind={p.kind}
  data-search={search}
  data-dl={repo?.downloads ?? 0}
  data-stars={repo?.stars ?? 0}
>
  <div class="header">
    <ProjectLogo project={p} />
    <div class="titles">
      <h3 class="name">
        <a class="open" href={`${base}projects/${p.slug}/`}>{p.title}</a>
        <span class:list={["status-dot", { off: p.archived }]} title={p.archived ? "Archived" : "Maintained"}></span>
      </h3>
      <div class:list={["sub", "kind-line", kindClass(p)]}>{kindLabel(p)}</div>
    </div>
    {p.archived ? (
      <span class="chip archived-chip" title={`Archived: now part of ${projects.find((o) => o.slug === p.replacedBy)?.title ?? "another project"}`}><Icon name="mdiArchiveOutline" />Archived</span>
    ) : (
      <MarketplaceBadge project={p} height={28} class="card-cta" />
    )}
  </div>

  {p.hero ? (
    <div class="preview">
      <Shot project={p} shot={p.hero} />
      {p.wip && !p.archived && (
        <div class="wip-ribbon" aria-hidden="true"><span><Icon name="mdiHardHat" />Work in progress</span></div>
      )}
      {p.archived && (
        <div class="tapes" aria-hidden="true">
          <div class="tape t1"><span>{"ARCHIVED · NO LONGER UPDATED · ".repeat(6)}</span></div>
          <div class="tape t2"><span>{"ARCHIVED · DO NOT INSTALL · ".repeat(6)}</span></div>
        </div>
      )}
    </div>
  ) : (
    <div class="preview compact">
      <ProjectLogo project={p} size="lg" />
      <span class="sub">Runs in the background, no dashboard of its own</span>
      {p.wip && !p.archived && (
        <div class="wip-ribbon" aria-hidden="true"><span><Icon name="mdiHardHat" />Work in progress</span></div>
      )}
    </div>
  )}

  <p class="tagline">{p.tagline}</p>

  {related.length > 0 && (
    <div class="works">
      <Icon name="mdiPuzzleOutline" />
      <span>Works with {related.map((o) => o.title).join(", ")}</span>
    </div>
  )}

  <div class="meta">
    {fresh && <span class="chip new-chip" title="Published this week">New</span>}
    {p.wip && <span class="chip wip-chip" title="Still being built: works, but changes from one release to the next"><Icon name="mdiHardHat" />Beta</span>}
    {anims > 0 && <span class="chip" style={`--c:${p.accent}`}><Icon name="mdiAnimationPlay" />{anims} animation{anims > 1 ? "s" : ""}</span>}
    {shots > 0 && <span class="chip neutral"><Icon name="mdiImageMultiple" />{shots}</span>}
    {repo && repo.downloads > 0 && <span class="chip neutral" title={`${repo.downloads.toLocaleString("en-US")} downloads of its releases`}><Icon name="mdiDownload" />{compact(repo.downloads)}</span>}
    {repo && repo.stars > 0 && <span class="chip neutral" title={`${repo.stars} star${repo.stars > 1 ? "s" : ""} on GitHub`}><Icon name="mdiStarOutline" />{repo.stars}</span>}
    {release && <span class="chip neutral" title={`Latest release, ${formatDate(release.date)}`}>{release.tag} · {short(release.date)}</span>}
    <span class="chip neutral">HA {p.homeassistant}+</span>
  </div>
</article>

<style>
  /* Work in progress: a corner ribbon of hazard tape, its stripes slowly moving */
  .project.wip .preview { position: relative; overflow: hidden; }
  .wip-ribbon {
    position: absolute; top: 30px; right: -58px; width: 230px; transform: rotate(35deg);
    padding: 3px 0; pointer-events: none; box-shadow: 0 2px 8px rgba(0,0,0,.25);
    background: repeating-linear-gradient(45deg, #EF9F27 0 9px, #412402 9px 18px);
    background-size: 25.5px 100%; animation: wip-tape 1.8s linear infinite;
  }
  .wip-ribbon span {
    display: flex; align-items: center; justify-content: center; gap: 4px;
    margin: 0 8px; padding: 3px 0; background: #FAC775; color: #412402;
    font: 700 10.5px/1 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase;
  }
  .wip-ribbon :global(svg) { width: 13px; height: 13px; }
  @keyframes wip-tape { to { background-position: 25.5px 0; } }
  @media (prefers-reduced-motion: reduce) { .wip-ribbon { animation: none; } }
  .wip-chip { --c: #BA7517; }
  .project.archived .preview { position: relative; overflow: hidden; }
  .project.archived .preview :global(img) { filter: grayscale(.85) brightness(.92); }
  /* Crime scene tape across the preview of an archived project */
  .tapes { position: absolute; inset: 0; pointer-events: none; }
  .tape {
    position: absolute; left: -20%; right: -20%; height: 30px;
    display: flex; align-items: center; overflow: hidden; white-space: nowrap;
    background: #f7d117; color: #111; box-shadow: 0 3px 10px rgba(0,0,0,.35);
    border-top: 3px solid #111; border-bottom: 3px solid #111;
    font: 800 13px/1 system-ui, sans-serif; letter-spacing: .14em;
  }
  .tape span { padding-left: 8px; }
  .t1 { top: 32%; transform: rotate(-9deg); }
  .t2 { top: 58%; transform: rotate(7deg); }
  .archived-chip {
    --c: #111; flex: none; background: #f7d117; color: #111; font-weight: 700;
    border: 2px solid #111; letter-spacing: .06em; text-transform: uppercase;
  }
  .project {
    display: flex; flex-direction: column; gap: 12px;
    padding: 12px;
    break-inside: avoid;
    /* Calm tile (the cards' look): neutral background, no border or shadow */
    background: var(--secondary-background-color);
    border-radius: var(--radius);
    transition: background-color 0.3s ease, transform 0.25s ease;
  }
  .project:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--c) 7%, var(--secondary-background-color)); }
  .project { position: relative; cursor: pointer; }
  .name { margin: 0; font-size: 16px; font-weight: 500; line-height: 1.25; display: flex; align-items: center; gap: 8px; }
  .name .status-dot { width: 8px; height: 8px; }
  .open { color: inherit; outline: none; }
  .new-chip {
    font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: var(--card-background-color); background: var(--success-color);
  }
  /* The title link covers the whole card */
  .open::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: var(--radius); }
  .project:has(.open:focus-visible) { outline: 2px solid var(--focus-color); outline-offset: 2px; }
  /* The badge stays clickable above it */
  .project :global(.card-cta) { position: relative; z-index: 2; }

  .preview {
    position: relative;
    height: 240px;
    border-radius: calc(var(--radius) - 4px);
    background: var(--primary-background-color);
    overflow: hidden;
    display: grid; place-items: center;
  }
  .preview :global(img) {
    width: 100%; height: 100%;
    object-fit: contain;
    transition: transform .4s ease;
  }
  /* Portrait captures: framed from the top, fading out */
  .preview :global(img[data-tall]) { object-fit: cover; object-position: top center; }
  .preview:has(:global(img[data-tall]))::after {
    content: ""; position: absolute; inset: auto 0 0; height: 35%;
    background: linear-gradient(to bottom, transparent, var(--primary-background-color));
    pointer-events: none;
  }
  .project:hover .preview :global(img) { transform: scale(1.02); }
  .preview.compact {
    height: 120px; display: flex; flex-direction: column; justify-content: center; gap: 8px;
    background: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--c) 14%, transparent), transparent 70%), var(--primary-background-color);
  }
  .works { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--secondary-text-color); margin-top: -4px; }
  .works :global(svg) { width: 16px; height: 16px; flex: none; color: var(--c); }

  .tagline { margin: 0; font-size: 14px; line-height: 1.45; color: var(--secondary-text-color); flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
