---
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import { kindLabel, type Project } from "../lib/projects";
import { latestRelease } from "../lib/releases";

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL;
const search = [p.title, p.slug, p.tagline, p.summary, ...p.highlights, ...(p.cardTypes ?? [])].join(" ").toLowerCase();
const shots = (p.screenshots?.length ?? 0) + (p.hero ? 1 : 0);
const anims = p.animations?.length ?? 0;
const release = await latestRelease(p);
---

<a
  class="ha-card project"
  href={`${base}projects/${p.slug}/`}
  style={`--c:${p.accent}`}
  data-kind={p.kind}
  data-with-card={p.withCard ? "1" : undefined}
  data-search={search}
>
  <div class="header">
    <span class="logo"><Icon name={p.icon} /></span>
    <div class="titles">
      <div class="name">{p.title}</div>
      <div class="sub">{kindLabel(p)}</div>
    </div>
    <Icon name="mdiChevronRight" class="go" />
  </div>

  <div class="preview">
    {p.hero ? <Shot project={p} shot={p.hero} /> : (
      <div class="placeholder"><span class="logo lg"><Icon name={p.icon} /></span><span class="sub">Runs in the background</span></div>
    )}
  </div>

  <p class="tagline">{p.tagline}</p>

  <div class="meta">
    {anims > 0 && <span class="chip" style={`--c:${p.accent}`}><Icon name="mdiAnimationPlay" />{anims} animation{anims > 1 ? "s" : ""}</span>}
    {shots > 0 && <span class="chip neutral"><Icon name="mdiImageMultiple" />{shots}</span>}
    {release && <span class="chip neutral" title="Latest release">{release.tag}</span>}
    <span class="chip neutral">HA {p.homeassistant}+</span>
  </div>
</a>

<style>
  .project {
    display: flex; flex-direction: column; gap: 12px;
    padding: 12px;
    break-inside: avoid;
  }
  .project:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(0,0,0,.05), 0 16px 32px -16px color-mix(in srgb, var(--c) 45%, transparent); }
  .project:hover .go { color: var(--c); transform: translateX(2px); }
  .go { width: 20px; height: 20px; color: var(--secondary-text-color); align-self: flex-start; margin-top: 2px; transition: transform .2s ease, color .2s ease; }

  .preview {
    position: relative;
    height: 240px;
    border-radius: var(--radius);
    background: var(--primary-background-color);
    overflow: hidden;
    display: grid; place-items: center;
  }
  .preview :global(img) {
    width: 100%; height: 100%;
    object-fit: contain;
    transition: transform .4s ease;
  }
  /* Portrait captures: framed from the top, fading out */
  .preview :global(img[data-tall]) { object-fit: cover; object-position: top center; }
  .preview:has(:global(img[data-tall]))::after {
    content: ""; position: absolute; inset: auto 0 0; height: 35%;
    background: linear-gradient(to bottom, transparent, var(--primary-background-color));
    pointer-events: none;
  }
  .project:hover .preview :global(img) { transform: scale(1.02); }
  .placeholder { display: grid; place-items: center; gap: 10px; }

  .tagline { margin: 0; font-size: 14px; line-height: 1.45; color: var(--secondary-text-color); flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
