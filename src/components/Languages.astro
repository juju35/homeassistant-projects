---
// "Speaks your language": one tile per language the cards and integrations ship, with its flag
// (flag-icons, MIT), its own name and a hello, French first. The tiles wave in one after the other on hover.
import Icon from "./Icon.astro";
import gb from "flag-icons/flags/4x3/gb.svg";
import fr from "flag-icons/flags/4x3/fr.svg";
import de from "flag-icons/flags/4x3/de.svg";
import es from "flag-icons/flags/4x3/es.svg";
import it from "flag-icons/flags/4x3/it.svg";
import nl from "flag-icons/flags/4x3/nl.svg";
import pt from "flag-icons/flags/4x3/pt.svg";
import pl from "flag-icons/flags/4x3/pl.svg";
import rs from "flag-icons/flags/4x3/rs.svg";
import ro from "flag-icons/flags/4x3/ro.svg";
import dk from "flag-icons/flags/4x3/dk.svg";
import se from "flag-icons/flags/4x3/se.svg";
import bg from "flag-icons/flags/4x3/bg.svg";
import ru from "flag-icons/flags/4x3/ru.svg";
import ua from "flag-icons/flags/4x3/ua.svg";
import hu from "flag-icons/flags/4x3/hu.svg";
import sk from "flag-icons/flags/4x3/sk.svg";
import cz from "flag-icons/flags/4x3/cz.svg";
import si from "flag-icons/flags/4x3/si.svg";
import lv from "flag-icons/flags/4x3/lv.svg";
import gr from "flag-icons/flags/4x3/gr.svg";

const LANGS = [
  { code: "fr", flag: fr, name: "Français", hello: "Bonjour" },
  { code: "en", flag: gb, name: "English", hello: "Hello" },
  { code: "de", flag: de, name: "Deutsch", hello: "Hallo" },
  { code: "es", flag: es, name: "Español", hello: "¡Hola!" },
  { code: "it", flag: it, name: "Italiano", hello: "Ciao" },
  { code: "nl", flag: nl, name: "Nederlands", hello: "Hallo" },
  { code: "pt", flag: pt, name: "Português", hello: "Olá" },
  { code: "pl", flag: pl, name: "Polski", hello: "Cześć" },
  { code: "sr", flag: rs, name: "Српски", hello: "Здраво" },
  { code: "sr-Latn", flag: rs, name: "Srpski", hello: "Zdravo" },
  { code: "ro", flag: ro, name: "Română", hello: "Bună" },
  { code: "da", flag: dk, name: "Dansk", hello: "Hej" },
  { code: "sv", flag: se, name: "Svenska", hello: "Hej" },
  { code: "bg", flag: bg, name: "Български", hello: "Здравей" },
  { code: "ru", flag: ru, name: "Русский", hello: "Привет" },
  { code: "uk", flag: ua, name: "Українська", hello: "Привіт" },
  { code: "hu", flag: hu, name: "Magyar", hello: "Szia" },
  { code: "sk", flag: sk, name: "Slovenčina", hello: "Ahoj" },
  { code: "cs", flag: cz, name: "Čeština", hello: "Ahoj" },
  { code: "sl", flag: si, name: "Slovenščina", hello: "Živjo" },
  { code: "lv", flag: lv, name: "Latviešu", hello: "Sveiki" },
  { code: "el", flag: gr, name: "Ελληνικά", hello: "Γεια σου" },
];
---

<section class="langs" id="languages" aria-labelledby="languages-title">
  <h2 class="section-title" id="languages-title"><Icon name="mdiTranslate" />Speaks your language<span class="count">{LANGS.length}</span></h2>
  <div class="ha-card langs-card">
    <p class="muted intro">
      Every card, editor and integration follows the language of your Home Assistant profile, or the one you pick in
      the card options. Dates, numbers and currencies use your locale too.
    </p>
    <ul class="lang-grid">
      {LANGS.map((l, i) => (
        <li class="lang tile" lang={l.code} style={`--i:${i}`}>
          <span class="flag"><img src={l.flag.src} alt="" width="40" height="30" loading="lazy" decoding="async" /></span>
          <span class="txt">
            <span class="hello">{l.hello}</span>
            <span class="lname muted">{l.name}</span>
          </span>
        </li>
      ))}
    </ul>
    <p class="muted note"><Icon name="mdiAccountVoice" /><span>A native speaker? Reviews of the newer translations are very welcome, see <a href="#contributing">Contributions</a>.</span></p>
  </div>
</section>

<style>
  .langs { margin-top: 40px; scroll-margin-top: 130px; }
  .count {
    font-size: 12px; letter-spacing: 0; text-transform: none;
    padding: 0 8px; border-radius: 10px; background: var(--card-background-color); border: 1px solid var(--divider-color);
  }
  .langs-card { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
  .intro, .note { margin: 0; font-size: 14px; max-width: 75ch; }
  .note { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .note svg { width: 18px; height: 18px; flex: none; }
  .note a { color: var(--primary-text-color); text-decoration: underline; text-underline-offset: 2px; }
  .lang-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px;
  }
  .lang {
    display: flex; align-items: center; gap: 12px; padding: 10px 12px; min-width: 0;
    transition: transform .25s ease, background-color .25s ease;
  }
  .lang:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--primary-color) 10%, var(--secondary-background-color)); }
  /* Flag: rounded, with a soft light sweep, and a little wave on hover */
  .flag {
    position: relative; flex: none; width: 40px; height: 30px; border-radius: 6px; overflow: hidden;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary-text-color) 12%, transparent), 0 2px 6px rgb(0 0 0 / .15);
    transform-origin: left center;
  }
  .flag img { width: 100%; height: 100%; object-fit: cover; }
  .flag::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(105deg, rgb(255 255 255 / .28), transparent 40%, rgb(0 0 0 / .08) 70%, rgb(255 255 255 / .12));
  }
  .lang:hover .flag { animation: wave 1.1s ease-in-out; }
  /* Once, as the section scrolls in: every flag waves, one after the other */
  .langs-card.seen .flag { animation: wave 1.1s ease-in-out calc(var(--i) * 60ms) both; }
  @keyframes wave {
    0%, 100% { transform: perspective(120px) rotateY(0) skewY(0); }
    30% { transform: perspective(120px) rotateY(-14deg) skewY(-2deg); }
    60% { transform: perspective(120px) rotateY(8deg) skewY(1.5deg); }
  }
  .txt { display: flex; flex-direction: column; min-width: 0; }
  .hello { font-size: 15px; font-weight: 500; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lname { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (prefers-reduced-motion: reduce) {
    .lang:hover .flag, .langs-card.seen .flag { animation: none; }
    .lang:hover { transform: none; }
  }
  @media (max-width: 600px) {
    .langs-card { padding: 16px; }
    .lang-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .lang { gap: 10px; padding: 8px 10px; }
    .flag { width: 32px; height: 24px; border-radius: 5px; }
  }
</style>

<script>
  // Wave the flags once when the section comes into view
  const card = document.querySelector(".langs-card");
  if (card && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        card.classList.add("seen");
        io.disconnect();
      }
    }, { threshold: 0.35 });
    io.observe(card);
  }
</script>
